        submitQuizGuess(nick, guess) {
            const encodedNick = encodeURIComponent(nick);
            const encodedGuess = encodeURIComponent(guess);
            return this.jsonpRequest(`${this.proxyUrl}?action=quiz_submit&nick=${encodedNick}&guess=${encodedGuess}`);
        }
    };
