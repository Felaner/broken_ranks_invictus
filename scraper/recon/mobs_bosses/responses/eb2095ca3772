function createStarryDustEffect() {
    const canvas = document.createElement('canvas');
    document.body.appendChild(canvas);
    const ctx = canvas.getContext('2d');

    // Make the canvas cover the visible portion of the window
    canvas.style.position = 'fixed'; // Fix canvas in place
    canvas.style.top = '0';
    canvas.style.left = '0';
    canvas.style.zIndex = '1';
    canvas.style.pointerEvents = 'none'; // Ensure the canvas does not interfere with interactions

    function resizeCanvas() {
        // Update canvas size based on visible portion of the window
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }

    // Initially resize the canvas
    resizeCanvas();

    const particles = [];
    const particleCount = 300; // Number of particles

    class Particle {
        constructor() {
            this.reset();
        }

        reset() {
            // Randomly position the particle within the visible area
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height;
            this.radius = Math.random() * 1.5 + 0.3; // Smaller particles
            this.alpha = 0; // Start with a transparent particle
            this.fadeSpeed = Math.random() * 0.01 + 0.005; // Slower fade speed for smoother transitions
            this.speedX = (Math.random() - 0.5) * 0.1; // Slower movement in X direction for smoothness
            this.speedY = (Math.random() - 0.5) * 0.1; // Slower movement in Y direction for smoothness
            this.life = Math.random() * 100 + 50; // Particle lifespan
            this.lifeElapsed = 0;
        }

        draw() {
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 255, 255, ${this.alpha})`;
            ctx.fill();
            ctx.closePath();
        }

        update() {
            this.x += this.speedX;
            this.y += this.speedY;

            // Update position when the particle goes off-screen
            if (this.x < 0 || this.x > canvas.width) this.speedX *= -1;
            if (this.y < 0 || this.y > canvas.height) this.speedY *= -1;

            // Increase opacity up to a point, then fade out
            if (this.lifeElapsed < this.life / 2) {
                this.alpha = Math.min(this.alpha + this.fadeSpeed, 1);
            } else {
                this.alpha = Math.max(this.alpha - this.fadeSpeed, 0);
            }

            this.lifeElapsed++;

            // Reset particle once its life ends
            if (this.lifeElapsed >= this.life) {
                this.reset();
            }
        }
    }

    function initParticles() {
        for (let i = 0; i < particleCount; i++) {
            particles.push(new Particle());
        }
    }

    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach(particle => {
            particle.update();
            particle.draw();
        });
        requestAnimationFrame(animate);
    }

    // Adjust canvas size when window is resized
    window.addEventListener('resize', resizeCanvas);

    initParticles();
    animate();
}

// Call the function to start the effect
createStarryDustEffect();



