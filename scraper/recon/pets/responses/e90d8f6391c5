    function createTable(body) {
        const table = document.createElement("table"),
            divi = document.createElement("div");

        divi.classList.add("divbg");
        table.style.top = window.scrollY + 40 + "px";
        table.id = "tableEq";
        body.prepend(divi);
        divi.prepend(table);
    }

    const table = document.querySelector("#tableEq");
    const divTable = document.querySelector(".divbg");

    function createModalMap(body) {
        const divbg = document.createElement("div"),
            mapContainer = document.createElement("div");

        // Основной оверлей
        divbg.classList.add("divbg");

        // Пустой контейнер под карту
        mapContainer.id = "mapEq";
        mapContainer.classList.add("map-window-shell");

        // Позиционирование, если нужно смещение от топа
        // (Хотя для fixed .divbg это обычно не требуется, оставляю по твоему примеру)
        // mapContainer.style.marginTop = "40px";

        // Сборка и добавление в DOM
        divbg.prepend(mapContainer);
        body.prepend(divbg);
        document.body.classList.add("no-scroll");

        // Возвращаем контейнер, если нужно сразу передать его в MapLibRender
        return mapContainer;
    }

    function createImageCell(table, src) {
        const tri = document.createElement("tr"),
            tdi = document.createElement("td"),
            divi = document.createElement("div"),
            imgi = document.createElement("img");
        table.prepend(tri);
        tri.prepend(tdi);
        tdi.classList.add("cell0");
        tdi.prepend(divi);
        divi.prepend(imgi);
        imgi.src = `${src}`;
        imgi.id = "ImageImg";
        imgi.style.cssText = `display: block; margin: auto;`;
    }

