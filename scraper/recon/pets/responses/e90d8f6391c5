    function findNestedObjects(objArray, keyValuesArray) {
        let resultArray = [];
        const uniquelds = {};
        const result = [];

        objArray.forEach((e) => {
            for (let key in e) {
                for (let ob in e[key]) {
                    keyValuesArray.forEach((r) => {
                        if (ob == r[0]) {
                            if (Array.isArray(e[key][ob])) {
                                if (e[key][ob].includes(r[1])) {
                                    resultArray.push(e[key]);
                                }
                            } else if (e[key][ob] == r[1]) {
                                resultArray.push(e[key]);
                            } else if (e[key][ob].includes(`${r[2]}`)) {
                                resultArray.push(e[key]);
                            }
                        }
                    });
                }
            }
        });

        resultArray.forEach((obj) => {
            if (!uniquelds[obj.id]) {
                uniquelds[obj.id] = true;
                result.push(obj);
            }
        });

        return result;
    }

    function calculateDifference(arr, percent) {
        let sum = arr.reduce((total, num) => total + num, 0);
        let A = sum;
        let B = A * (1 + percent / 100);
        let difference = B - A;
        // return Math.round(difference);
        return difference.toFixed(1);
    }

    function distributeNumber(arr, num) {
        if (arr.length === 0) {
            return [];
        }

        const average = Math.floor(num / arr.length);
        const remainder = num % arr.length;

        const result = arr.map((value) => value + average);

        for (let i = 0; i < remainder; i++) {
            const randomIndex = Math.floor(Math.random() * arr.length);
            result[randomIndex]++;
        }

        return result;
    }

