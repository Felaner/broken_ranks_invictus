                id: "common",
                title: "Общее",
                expected: 9,
                icon:
                    options.commonIcons?.common || "/raresImg/skillsN/1/2.png",
                getBlock: () => commonBlock.common,
            },
            {
                id: "special",
                title: "Особые",
                expected: 3,
                icon:
                    options.commonIcons?.special ||
                    "/raresImg/skillsN/1/525.png",
                getBlock: () => commonBlock.special,
            },
            {
                id: "passive",
                title: "Пассивные",
                // expected: 1,
                icon:
                    options.commonIcons?.passive ||
                    "/raresImg/skillsN/1/10.png",
                getBlock: () => commonBlock.passive,
            },
        ];

        // Активная вкладка сверху: класс или common/special/passive
        let activeTopId =
            options.defaultActiveId &&
            (classesMain[options.defaultActiveId] ||
                commonTabs.some((t) => t.id === options.defaultActiveId))
                ? options.defaultActiveId
                : classIds[0] || "common";

        // Правая панель: 3 кнопки
        const panelTabs = [
            { id: "skills", label: "Навыки" },
            { id: "equipment", label: "Классовая экипировка" },
            // { id: "misc", label: "Разное" },
        ];
        let activePanelTab = "skills";

        /* ================= HELPERS ================= */
        function getSkillName(skillId) {
            try {
                const meta = findAnteikuDB(anteikuDB, [["id", skillId]]);
                return meta?.title || skillId;
            } catch {
                return skillId;
            }
        }

        function normalizeIconHtml(html, id) {
            return String(html).replace(
                /data-items="[^"]*"/g,
                `data-items="${id}"`,
            );
        }

        function skillsToArray(obj) {
            const keys = Object.keys(obj || {}).sort(); // skillCl1..skillClN
            return keys.map((k) => {
                const arr = obj[k];
                const id = arr?.[0];
                const icon = normalizeIconHtml(arr?.[1] || "", id);
                return { id, icon, name: getSkillName(id) };
            });
        }

        function setTopSelected() {
            top.querySelectorAll(".tp-tab").forEach((b) => {
                b.setAttribute(
                    "aria-selected",
                    b.dataset.id === activeTopId ? "true" : "false",
                );
            });
        }

        /* ================= RENDER TOP ================= */
        function renderTopTabs() {
            top.innerHTML = "";

            // 7 классов
            classIds.forEach((id) => {
                const c = classesMain[id];
                const b = document.createElement("button");
                b.className = "tp-tab";
                b.dataset.id = id;
                b.title = c.name;
                b.innerHTML = `<img src="${c.icon}" alt="${c.name}">`;
                b.onclick = () => {
                    activeTopId = id;
                    activePanelTab = "skills";
                    render();
                };
                top.appendChild(b);
            });

            // разделитель
