    try {
        (function initBatSwarm() {
            const canvas = document.createElement(`canvas`);
            const ctx = canvas.getContext(`2d`);
            const header = document.getElementById(`customHeader`);
            let heartActive = false;
            let heartTimer = 0;
            let heartCooldown = 0;
            let avatarEl = null;

            Object.assign(canvas.style, {
                position: `fixed`,
                top: `0`,
                left: `0`,
                width: `100%`,
                height: `100%`,
                pointerEvents: `none`,
                zIndex: `2000`,
                display: `block`,
            });
            document.body.appendChild(canvas);

            const mouse = { x: -9999, y: -9999 };
            window.addEventListener(`resize`, () => {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            });
            window.dispatchEvent(new Event(`resize`));
            window.addEventListener(`mousemove`, (e) => {
                mouse.x = e.clientX;
                mouse.y = e.clientY;
            });

            window.addEventListener(
                `scroll`,
                () => {
                    const panicDir = Math.random() > 0.5 ? 1 : -1;
                    bats.forEach((bat) => {
                        if (bat.isSleeping || bat.goToSleep) {
                            bat.isSleeping = false;
                            bat.goToSleep = false;
                            bat.vx = panicDir * 4 + (Math.random() - 0.5) * 4;
                            bat.vy = 2 + Math.random() * 3;
                        }
                    });
                },
                { passive: true },
            );

            class Bat {
                constructor() {
                    this.init();
                }

                init() {
                    this.x = Math.random() * canvas.width;
                    this.y = Math.random() * canvas.height;
                    this.vx = (Math.random() - 0.5) * 4;
                    this.vy = (Math.random() - 0.5) * 4;
                    this.size = 4 + Math.random() * 4;
                    this.flap = Math.random() * Math.PI * 2;
                    this.depth = 0.5 + Math.random() * 0.5;
                    this.maxSpeed = 2.5 + Math.random() * 2;
                    this.isSleeping = false;
                    this.goToSleep = false;
                    this.landingTimer = 0;
                    this.isBlinking = false;
                    this.blinkTimer = 0;
                }

                update(bats) {
                    const mDist = Math.hypot(
                        this.x - mouse.x,
                        this.y - mouse.y,
                    );
                    if (this.isSleeping && mDist < 50) {
                        this.isSleeping = false;
                        this.vy = 2;
                        this.vx = (Math.random() - 0.5) * 6;
                    }
                    if (heartActive && avatarEl && this.isSleeping) {
                        this.isSleeping = false;
                    }
                    if (this.isSleeping) {
                        if (this.isBlinking) {
                            this.blinkTimer--;
                            if (this.blinkTimer <= 0) {
                                this.isBlinking = false;
                            }
                        } else if (Math.random() < 0.005) {
                            this.isBlinking = true;
                            this.blinkTimer =
                                10 + Math.floor(Math.random() * 15);
                        }
                        return;
                    }

                    if (heartActive && avatarEl) {
                        this.goToSleep = false;
                        const rect = avatarEl.getBoundingClientRect();
                        if (rect.width === 0) {
                            heartActive = false;
                            heartCooldown = 600;
                        } else {
                            const index = bats.indexOf(this);
                            const t = (index / bats.length) * Math.PI * 2;
                            const hx = 16 * Math.pow(Math.sin(t), 3);
                            const hy = -(
                                13 * Math.cos(t) -
                                5 * Math.cos(2 * t) -
                                2 * Math.cos(3 * t) -
                                Math.cos(4 * t)
                            );
                            const targetX =
                                rect.left + rect.width / 2 + hx * 6.5;
                            const targetY =
                                rect.top + rect.height / 2 + hy * 6.5;
                            const dx = targetX - this.x;
                            const dy = targetY - this.y;
                            this.vx += dx * 0.05;
                            this.vy += dy * 0.05;
                            this.vx *= 0.82;
                            this.vy *= 0.82;
                        }
                        if (mDist < 80) {
                            this.vx += ((this.x - mouse.x) / mDist) * 1.2;
                            this.vy += ((this.y - mouse.y) / mDist) * 1.2;
                        }
                    } else if (
                        header &&
                        Math.random() < 0.0012 &&
                        !this.goToSleep
                    ) {
                        const rect = header.getBoundingClientRect();
                        if (rect.bottom > 0) {
                            this.targetSleepX =
                                rect.left + Math.random() * rect.width;
                            this.targetSleepY = rect.bottom;
                            this.goToSleep = true;
                            this.landingTimer = 0;
                        }
                    }

                    if (this.goToSleep) {
                        const dx = this.targetSleepX - this.x;
                        const dy = this.targetSleepY - this.y;
                        const distToTarget = Math.hypot(dx, dy);

                        this.vx += dx * 0.02;
                        this.vy += dy * 0.02;
                        this.landingTimer++;

                        if (distToTarget < 4) {
                            this.isSleeping = true;
                            this.goToSleep = false;
                            this.vx = this.vy = 0;
                            this.x = this.targetSleepX;
                            this.y = this.targetSleepY;
                        }
                        if (this.landingTimer > 180) {
                            this.goToSleep = false;
                        }
                    } else if (!heartActive || !avatarEl) {
                        let sep = { x: 0, y: 0 },
                            ali = { x: 0, y: 0 },
                            coh = { x: 0, y: 0 },
                            total = 0;
                        const visualRange = 120;

                        bats.forEach((other) => {
                            let d = Math.hypot(
                                this.x - other.x,
                                this.y - other.y,
                            );
                            if (
                                other !== this &&
                                !other.isSleeping &&
                                d < visualRange
                            ) {
                                if (d < 30) {
                                    sep.x += this.x - other.x;
                                    sep.y += this.y - other.y;
                                }
                                ali.x += other.vx;
                                ali.y += other.vy;
                                coh.x += other.x;
                                coh.y += other.y;
                                total++;
                            }
                        });

                        if (total > 0) {
                            this.vx +=
                                sep.x * 0.05 +
                                (ali.x / total - this.vx) * 0.04 +
                                (coh.x / total - this.x) * 0.002;
                            this.vy +=
                                sep.y * 0.05 +
                                (ali.y / total - this.vy) * 0.04 +
                                (coh.y / total - this.y) * 0.002;
                        }

                        if (mDist < 100) {
                            this.vx += ((this.x - mouse.x) / mDist) * 1.2;
                            this.vy += ((this.y - mouse.y) / mDist) * 1.2;
                        }

                        this.vx += (Math.random() - 0.5) * 0.2;
                        this.vy += (Math.random() - 0.5) * 0.2;
                    }

                    const speed = Math.hypot(this.vx, this.vy);
                    if (speed > this.maxSpeed) {
                        this.vx = (this.vx / speed) * this.maxSpeed;
                        this.vy = (this.vy / speed) * this.maxSpeed;
                    }
                    this.x += this.vx;
                    this.y += this.vy;
                    this.flap += 0.5;

                    if (this.x > canvas.width + 50) this.x = -50;
                    else if (this.x < -50) this.x = canvas.width + 50;
                    if (this.y > canvas.height + 50) this.y = -50;
                    else if (this.y < -50) this.y = canvas.height + 50;
                }

                draw() {
                    ctx.save();
                    ctx.translate(this.x, this.y);
                    ctx.scale(this.depth, this.depth);
                    ctx.globalAlpha = this.depth;

                    const bodyColor = `#050505`;
                    const s = this.size;

                    if (this.isSleeping) {
                        ctx.fillStyle = bodyColor;
                        ctx.beginPath();
                        ctx.ellipse(
                            0,
                            s * 0.5,
                            s * 0.5,
                            s * 1.2,
                            0,
                            0,
                            Math.PI * 2,
                        );
                        ctx.fill();
                        if (!this.isBlinking) {
                            ctx.fillStyle = `#A62000`;
                            ctx.beginPath();
                            ctx.arc(
                                -s * 0.15,
                                s * 1.3,
                                s * 0.15,
                                0,
                                Math.PI * 2,
                            );
                            ctx.arc(
                                s * 0.15,
                                s * 1.3,
                                s * 0.15,
                                0,
                                Math.PI * 2,
                            );
                            ctx.fill();
                        }
                    } else {
                        ctx.rotate(Math.atan2(this.vy, this.vx));
                        const wingAngle = Math.sin(this.flap) * 0.8;
                        ctx.fillStyle = bodyColor;

                        ctx.save();
                        ctx.rotate(wingAngle);
                        ctx.beginPath();
                        ctx.moveTo(0, 0);
                        ctx.bezierCurveTo(
                            -s * 1.5,
                            -s * 0.5,
                            -s * 2.5,
                            s * 0.5,
                            -s * 3,
                            0,
                        );
                        ctx.bezierCurveTo(
                            -s * 1.5,
                            s * 1.5,
                            -s * 0.5,
                            s * 0.5,
                            0,
                            0,
                        );
                        ctx.fill();
                        ctx.restore();

                        ctx.save();
                        ctx.rotate(-wingAngle);
                        ctx.beginPath();
                        ctx.moveTo(0, 0);
                        ctx.bezierCurveTo(
                            s * 1.5,
                            -s * 0.5,
                            s * 2.5,
                            s * 0.5,
                            s * 3,
                            0,
                        );
                        ctx.bezierCurveTo(
                            s * 1.5,
                            s * 1.5,
                            s * 0.5,
                            s * 0.5,
                            0,
                            0,
                        );
                        ctx.fill();
                        ctx.restore();

                        ctx.beginPath();
                        ctx.ellipse(0, 0, s * 0.5, s * 0.8, 0, 0, Math.PI * 2);
                        ctx.fill();

                        if (
                            heartActive &&
                            Math.floor(Date.now() / 150) % 2 === 0
                        ) {
                            ctx.fillStyle = `#FFFF00`;
                            ctx.shadowColor = `#FFFF00`;
                            ctx.shadowBlur = 4;
                        } else {
                            ctx.fillStyle = `#A62000`;
                            ctx.shadowColor = `#FF0000`;
                            ctx.shadowBlur = 2;
                        }
                        ctx.beginPath();
                        ctx.arc(-s * 0.2, -s * 0.5, s * 0.15, 0, Math.PI * 2);
                        ctx.arc(s * 0.2, -s * 0.5, s * 0.15, 0, Math.PI * 2);
                        ctx.fill();
                    }
                    ctx.restore();
                }
            }

            const bats = Array.from({ length: 30 }, () => new Bat());
            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                if (heartActive) {
                    heartTimer--;
                    if (heartTimer <= 0) {
                        heartActive = false;
                        heartCooldown = 600;
                    }
                } else {
                    if (heartCooldown > 0) heartCooldown--;
                    if (heartCooldown <= 0 && Math.random() < 0.0003) {
                        avatarEl = document.querySelector(
                            `img[src$="shell.pers.hd.webp"]`,
                        )
                            ? document.querySelector(
                                  `img[src$="shell.pers.hd.webp"]`,
                              )
                            : document.querySelector(
                                  `img[src="img/1.webp?114"]`,
                              );
                        if (avatarEl && avatarEl.offsetWidth > 0) {
                            heartActive = true;
                            heartTimer = 480;
                        }
                    }
                }
                bats.forEach((bat) => {
                    bat.update(bats);
                    bat.draw();
                });
                requestAnimationFrame(animate);
            }
            animate();
        })();
    } catch (e) {
        console.log(e);
    }
}

