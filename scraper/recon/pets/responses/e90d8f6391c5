    function getValueByPath(obj, path) {
        return path.split(".").reduce((acc, key) => acc?.[key], obj);
    }

    function byField(path, fallbackField = null) {
        return (a, b) => {
            let valA = getValueByPath(a, path);
            let valB = getValueByPath(b, path);

            const hasA = valA !== undefined && valA !== null;
            const hasB = valB !== undefined && valB !== null;

            // 👉 fallback ТОЛЬКО для powerG.n
            if (path === "powerG.n" && fallbackField) {
                if (hasA && !hasB) return -1;
                if (!hasA && hasB) return 1;

                if (!hasA && !hasB) {
                    valA = getValueByPath(a, fallbackField);
                    valB = getValueByPath(b, fallbackField);
                }
            }

            // 👉 числа
            if (typeof valA === "number" && typeof valB === "number") {
                return valA - valB;
            }

            // 👉 строки
            return String(valA || "").localeCompare(String(valB || ""));
        };
    }

