// Функция удаления прелоадера
function removePreloader() {
    const loader = document.querySelector(".loader-container");
    if (loader) {
        loader.remove();
    }
}

async function loadAnteikuDB(url) {
    const cachedMain = localStorage.getItem(url);
    const mapUrl = `/raresImg/all_map_elements.json`;
    const cachedMap = localStorage.getItem(mapUrl);

    let cachedVersion = null;
    let cachedMapVersion = null;

    if (cachedMain) {
        const parsedMain = JSON.parse(cachedMain);
        anteikuDB = parsedMain.data;
        cachedVersion = parsedMain.version;
    }

    if (cachedMap) {
        const parsedMap = JSON.parse(cachedMap);
        mapsDB = parsedMap.data;
        cachedMapVersion = parsedMap.version;
    }

    try {
        const newDataVers = await getResource(
            `/raresImg/anteikuDBversion.json?_=${Date.now()}`,
        );

        // Проверка основной базы
        if (cachedVersion !== newDataVers.version) {
            const newData = await getResource(
                `/raresImg/anteikuDB.json?_=${Date.now()}`,
            );
            localStorage.setItem(url, JSON.stringify(newData));
            anteikuDB = newData.data;
            console.log(
                "Основная версия обновлена: " + `${newDataVers.version}`,
            );
        } else {
            console.log("Основная база: кеш - " + `${cachedVersion}`);
        }

        // Проверка базы карт
        if (cachedMapVersion !== newDataVers.versionMap) {
            const newMapData = await getResource(`${mapUrl}?_=${Date.now()}`);
            localStorage.setItem(mapUrl, JSON.stringify(newMapData));
            mapsDB = newMapData.data;
            console.log(
                "Версия карт обновлена: " + `${newDataVers.versionMap}`,
            );
        } else {
            console.log("База карт: кеш - " + `${cachedMapVersion}`);
        }

        if (!mainCodeExecuted) {
            mainCodeExecuted = true;
            runMainCode();
        }
    } catch (error) {
        console.error("❌ Ошибка загрузки JSON:", error);

        if ((anteikuDB || mapsDB) && !mainCodeExecuted) {
            mainCodeExecuted = true;
            runMainCode();
        }
    }
}

// Функция для загрузки JSON
async function getResource(url) {
    const res = await fetch(url);
    if (!res.ok) {
        throw new Error(`Ошибка загрузки ${url}, статус: ${res.status}`);
    }
    return await res.json();
}

// Функция поиска
function findAnteikuDB(obj, searchCriteria) {
    const results = [];

    function search(currentObj, criteria) {
        for (const key in currentObj) {
            if (typeof currentObj[key] === "object") {
                search(currentObj[key], criteria); // Рекурсивный поиск
            } else if (
                criteria.length === 1 &&
                key === criteria[0][0] &&
                (currentObj[key] === criteria[0][1] ||
                    currentObj[key].includes(`${criteria[0][2]}`))
            ) {
                results.push(currentObj); // Найдено совпадение
            }
        }
    }

    for (const criterion of searchCriteria) {
        search(obj, [criterion]); // Запуск поиска
    }

    return results.length > 1 ? results : results[0]; // Массив или один объект
}

