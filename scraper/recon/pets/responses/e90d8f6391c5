                color: orange;
            }
            .infusion-table-wrap tr:hover td {
                background: #0c0c0c;
            }
            `;
            document.head.appendChild(styleEl);
        }

        const container = document.createElement(`div`);
        container.className = `infusion-container`;

        const tabsContainer = document.createElement(`div`);
        tabsContainer.className = `infusion-tabs`;

        const tableContainer = document.createElement(`div`);
        tableContainer.className = `infusion-table-wrap`;

        const types = [
            { key: `damage`, name: t.damage },
            { key: `reduction`, name: t.reduction },
            { key: `reflection`, name: t.reflection },
            { key: `accuracy`, name: t.accuracy },
            { key: `defense`, name: t.defense },
        ];

        types.forEach((type, index) => {
            const btn = document.createElement(`button`);
            btn.className = `infusion-tab-btn`;
            if (index === 0) btn.classList.add(`active`);
            btn.textContent = type.name;

            btn.addEventListener(`click`, () => {
                container
                    .querySelectorAll(`.infusion-tab-btn`)
                    .forEach((b) => b.classList.remove(`active`));
                container
                    .querySelectorAll(`.infusion-view`)
                    .forEach((v) => (v.style.display = `none`));
                btn.classList.add(`active`);
                const targetView = container.querySelector(`.view-${type.key}`);
                if (targetView) targetView.style.display = `block`;
            });

            tabsContainer.appendChild(btn);
        });

        types.forEach((type, index) => {
            const view = document.createElement(`div`);
            view.className = `infusion-view view-${type.key}`;
            if (index !== 0) view.style.display = `none`;

            let html = `<table><thead><tr><th>${t.lvl}</th>`;
            if (type.key === `reflection`) {
                html += `<th>${t.chance}</th><th>${t.red}</th><th>${t.ref}</th>`;
            } else {
                html += `<th>${t.value}</th>`;
            }
            html += `</tr></thead><tbody>`;

            for (let lvl = 1; lvl <= 12; lvl++) {
                const base = infusionBaseData[lvl];
                let displayValue = ``;

                if (multiplier === 0) {
                    if (type.key === `reflection`) {
                        displayValue = `<td><span>0.0%</span></td><td>${base.reflectionReduced}</td><td>${base.reflectionReflected}</td>`;
                    } else if (
                        type.key === `accuracy` ||
                        type.key === `defense`
                    ) {
                        displayValue = `<td><span>+0</span></td>`;
                    } else {
                        displayValue = `<td><span>0.0%</span></td>`;
                    }
                } else {
                    const parsePct = (str) => parseFloat(str.replace(`%`, ``));
                    const parseNum = (str) =>
                        parseInt(str.replace(`+`, ``), 10);

                    if (type.key === `reflection`) {
                        const finalChance = (
                            parsePct(base.reflectionChance) * multiplier
                        ).toFixed(1);
                        displayValue = `<td><span>${finalChance}%</span></td><td>${base.reflectionReduced}</td><td>${base.reflectionReflected}</td>`;
                    } else if (
                        type.key === `accuracy` ||
                        type.key === `defense`
                    ) {
                        const finalNum = Math.round(
                            parseNum(base[type.key]) * multiplier,
                        );
                        displayValue = `<td><span>+${finalNum}</span></td>`;
                    } else {
                        const finalPct = (
                            parsePct(base[type.key]) * multiplier
                        ).toFixed(1);
                        displayValue = `<td><span>${finalPct}%</span></td>`;
                    }
                }

                html += `<tr><td>${lvl}</td>${displayValue}</tr>`;
            }

            html += `</tbody></table>`;
            view.innerHTML = html;
            tableContainer.appendChild(view);
        });

        container.appendChild(tabsContainer);
        container.appendChild(tableContainer);
        return container;
    }

