    function getArenaAsp(obj, name, compact) {
        let key = ``;
        if (translatePL == true) {
            key = `enAsp`;
        } else if (translateEN == true) {
            key = `enAsp`;
        } else {
            key = `ruAsp`;
        }

        const index = obj[`enAsp`].indexOf(name);

        if (index === -1) {
            return null; // не найдено
        }

        const img = obj.imgAsp[index];
        const text = obj[key][index];

        // ЕСЛИ передан 3-й параметр → компактный режим
        if (compact !== undefined) {
            return `<img src="${obj.aspWay}${img}" style="position:absolute; top:4px; right:4px;max-width: 24px;" title="${text}">`;
        }

        // старое поведение (ничего не ломается)
        return `<div style="display:flex;justify-content:center;align-items:center;">
                <img src="${obj.aspWay}${img}" style="max-width: 30px;">
                <span style="color:#1EFCA6;">${text}</span>
