                }

                champList.appendChild(wrapper);
            }

            Object.keys(btns).forEach((key) => {
                const idx = Number(key);
                const btn = btns[idx];

                btn.onclick = () => {
                    if (pressed[idx]) return;

                    if (first === null) {
                        first = idx;
                        Object.values(btns).forEach((b) =>
                            b.classList.remove("selected-btn"),
                        );
                        btn.classList.add("selected-btn");
                        infoHeader.innerText = `Первая кнопка: ${first}. Выбери вторую.`;
                        return;
                    }

                    if (first === idx) {
                        infoHeader.innerText =
                            "Выбрана та же кнопка — выберите другую.";
                        return;
                    }

                    const second = idx;
                    appendChampionCard(first, second);

                    [first, second].forEach((n) => {
                        pressed[n] = true;
                        const bDone = btns[n];
                        bDone.disabled = true;
                        bDone.innerText = "✔";
                        bDone.classList.remove("selected-btn");
                    });

                    first = null;
                    const allDone = [1, 2, 3, 4].every((x) => pressed[x]);
                    if (allDone) {
                        const doneMsg = el("div", {
                            innerHTML:
                                "<strong style='display:block;margin-top:16px;font-size:16px;color:#619b3f;'>Этап 3 завершён! Отличная работа!</strong>",
                            style: { textAlign: "center" },
                        });
                        content.appendChild(doneMsg);

                        const cont = el("div", {
                            style: {
                                marginTop: "14px",
                                display: "flex",
                                gap: "10px",
                                justifyContent: "center",
                                width: `100%`,
                            },
                        });
                        const rBtn = el("button", {
                            className: "nav-btn",
                            innerText: "Заново",
                        });
                        rBtn.onclick = () => startStage3();
                        cont.appendChild(rBtn);
                        content.appendChild(cont);
                        infoHeader.innerText = "Все пары выполнены.";
                    } else {
                        infoHeader.innerText =
                            "Пара добавлена. Выберите следующую пару.";
                    }
                };
            });
        }

        function addContinueButton(nextStageNumber) {
            const cont = el("div", {
                style: {
                    display: "flex",
                    gap: "8px",
                    justifyContent: "center",
                    marginTop: "14px",
                    width: `100%`,
                },
            });
            const btn = el("button", {
