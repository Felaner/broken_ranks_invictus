            function appendChampionCard(a, bIdx) {
                const pair = String(a) + String(bIdx);
                const alt = String(bIdx) + String(a);
                const champ = CHAMPIONS[pair] || CHAMPIONS[alt];
                const wrapper = el("div", { className: "champ-card" });
                const cardTitle = el("div", {
                    innerText: `Пара: ${a} + ${bIdx}`,
                    style: { fontSize: "13px", color: "#e0d074" },
                });
                wrapper.appendChild(cardTitle);

                if (champ) {
                    const imgWrap = el("div", { innerHTML: champ.img || "" });
                    const name = el("strong", {
                        innerText: champ.name || "Без имени",
                        style: { fontSize: "15px", color: "#ce8d42" },
                    });
                    const meta = el("div", {
                        className: "small",
                        innerText: `Призывают — ${champ.role} — ${champ.block}`,
                        style: { color: "#888" },
                    });
                    wrapper.appendChild(imgWrap);
                    wrapper.appendChild(name);
                    wrapper.appendChild(meta);
                } else {
                    wrapper.appendChild(
                        el("div", {
                            innerText: "Такой комбинации нет.",
                            style: { color: "#A62000" },
