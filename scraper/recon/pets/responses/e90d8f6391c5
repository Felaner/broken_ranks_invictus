    function addEq(item) {
        item.history = `+`;
        let link = ``;
        let stX = +localStorage.getItem("stX");
        createTable(document.body);
        const table = document.querySelector("#tableEq");
        //создание ячеек таблицы
        for (let key in item) {
            //назначение ранга предмету в зависимости от требуемого уровня
            if (item.titlePets) {
                item.rang = "";
            } else if (item.title === "Бастион" || item.title === "Гусария") {
                item.rang = `<span style="color:#e0d074;">IV</span>`;
                item.zaryadka = "3";
            } else if (item.title === "Гйольмар" || item.title === "Батагур") {
                item.rang = `<span style="color:#e0d074;">VII</span>`;
            } else if (
                item.titleEpic &&
                (item.trebLvl === 60 || item.trebLvl === 120)
            ) {
                item.rang = `<span style="color:#e0d074;">${item.trebLvl === 60 ? "IX" : "XII"}</span>`;
            } else if (item.trebLvl >= 1 && item.trebLvl <= 140) {
                const levels = [
                    12, 24, 36, 48, 60, 72, 84, 96, 108, 120, 132, 140,
                ];
                const ranks = [
                    "I",
                    "II",
                    "III",
                    "IV",
                    "V",
                    "VI",
                    "VII",
                    "VIII",
                    "IX",
                    "X",
                    "XI",
                    "XII",
                ];
                let index = levels.findIndex((lvl) => item.trebLvl <= lvl);

                if (
                    (index === 3 &&
                        (item.title === "Бастион" ||
                            item.title === "Гусария")) ||
                    (index === 7 &&
                        (item.title === "Гйольмар" ||
                            item.title === "Батагур")) ||
                    (index === 4 && item.titleEpic) ||
                    (index === 9 && item.titleEpic)
