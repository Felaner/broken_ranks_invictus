    function updateLangHighlight() {
        // Находим иконки по ID
        const imgPL = document.getElementById("langPL");
        const imgEN = document.getElementById("langEN");
        const imgRU = document.getElementById("langRU");

        // Массив для удобного перебора
        const langs = [imgPL, imgEN, imgRU];

        // 1. Очищаем старое выделение у всех иконок
        langs.forEach((img) => {
            if (img) img.classList.remove("active-lang");
        });

        // 2. Устанавливаем класс только активному языку
        // Используем твои переменные translatePL и translateEN
        if (typeof translatePL !== "undefined" && translatePL === true) {
            if (imgPL) imgPL.classList.add("active-lang");
        } else if (typeof translateEN !== "undefined" && translateEN === true) {
            if (imgEN) imgEN.classList.add("active-lang");
        } else {
            // Если оба false, значит активен RU
            if (imgRU) imgRU.classList.add("active-lang");
        }
    }

