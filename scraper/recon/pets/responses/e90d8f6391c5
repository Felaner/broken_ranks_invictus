                width: 100%;
                border-collapse: collapse;
                text-align: center;
                color: #E5E6E7;
            }
            .infusion-table-wrap th {
                background: #0a0a0a;
                color: #e0d074;
                padding: ${headerPadding};
                font-weight: normal;
            }
            .infusion-table-wrap td {
                padding: 1px 2px;
                border-bottom: 1px solid #0c0c0c;
