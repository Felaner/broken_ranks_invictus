    function findMatchingObjects(arr, searchStr) {
        let searchtxt = searchStr
            .replace(/ё/g, "е")
            .replace(/'/g, "")
            .toLowerCase();
        let matchingIds = [];

        arr.forEach((subArr) => {
            subArr.forEach((obj) => {
                if (
                    obj.title &&
                    obj.title
                        .toLowerCase()
                        .replace(/ё/g, "е")
                        .replace(/'/g, "")
                        .includes(searchtxt)
                ) {
                    matchingIds.push(obj.id);
                } else if (
                    obj.titlePL &&
                    obj.titlePL
                        .toLowerCase()
                        .replace(/ё/g, "е")
                        .replace(/'/g, "")
                        .includes(searchtxt)
                ) {
                    matchingIds.push(obj.id);
                } else if (
                    obj.titleEN &&
                    obj.titleEN
                        .toLowerCase()
                        .replace(/ё/g, "е")
                        .replace(/'/g, "")
                        .includes(searchtxt)
                ) {
                    matchingIds.push(obj.id);
                }
            });
        });

        return matchingIds;
    }

