    function addEffectShow() {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("showAppear");
                } else {
                    entry.target.classList.remove("showAppear");
                }
            });
        }, {});

        const todoElements = document.querySelectorAll(".flex-sec-cont");
        todoElements.forEach((el) => observer.observe(el));
    }

    function buildCarousel(items, selector = ".carousel") {
        const carousel = document.querySelector(selector);
        if (!carousel) return;

        carousel.innerHTML = "";

        items.forEach((item, index) => {
            const carouselItem = document.createElement("div");
            carouselItem.className = "carousel-item";

            const safeId = item.title.replace(/[^a-zA-Z0-9а-яА-Я]/g, `_`);

            carouselItem.innerHTML = `
            <div class="carousel-box" data-id="${safeId}">
                <div class="fb-rating-panel">
                    <button class="fb-rate-btn fb-like">
                        ❤ <span class="fb-count">0</span>
                    </button>
                    <button class="fb-rate-btn fb-dislike">
                        👎 <span class="fb-count">0</span>
                    </button>
                </div>
                <div class="carousel-title">
                    ${item.title}
                    <img class="img_cl_tl" src="${item.logo || "img/brlogolightsmall.png"}" />
                </div>
                <div class="num">${item.num || index + 1}</div>
                <img class="item_cl" src="${item.img}" loading="lazy" />
            </div>
        `;

            const likeBtn = carouselItem.querySelector(".fb-like");
            const dislikeBtn = carouselItem.querySelector(".fb-dislike");

            if (likeBtn) {
                likeBtn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    processFbRate(likeBtn, safeId, "likes");
                });
            }

            if (dislikeBtn) {
                dislikeBtn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    processFbRate(dislikeBtn, safeId, "dislikes");
                });
            }

            carousel.appendChild(carouselItem);

            if (window.fbApi && window.fbApi.getInteractions) {
                window.fbApi.getInteractions(safeId).then((data) => {
                    if (data) {
                        const likeCount =
                            carouselItem.querySelector(".fb-like .fb-count");
                        const dislikeCount = carouselItem.querySelector(
                            ".fb-dislike .fb-count",
                        );
                        if (likeCount) likeCount.textContent = data.likes || 0;
                        if (dislikeCount)
                            dislikeCount.textContent = data.dislikes || 0;

                        const voted = localStorage.getItem(`voted_${safeId}`);
                        if (voted) {
                            const votedBtn = carouselItem.querySelector(
                                `.fb-${voted}`,
                            );
                            if (votedBtn) {
                                votedBtn.classList.add(`fb-voted-active`);
                                const box = votedBtn.closest(`.carousel-box`);
                                if (box) {
                                    box.querySelectorAll(
                                        `.fb-rate-btn`,
                                    ).forEach((btn) => {
                                        if (
                                            !btn.classList.contains(
                                                `fb-voted-active`,
                                            )
                                        ) {
                                            btn.style.opacity = `0.4`;
                                            btn.style.pointerEvents = `none`;
                                            btn.style.cursor = `default`;
                                        }
                                    });
                                }
                            }
                        }
                    }
                });
            }
        });
    }

    function processFbRate(clickedBtn, itemId, actionType) {
        const storageKey = `voted_${itemId}`;
        const alreadyVoted = localStorage.getItem(storageKey);

        if (alreadyVoted) {
            return;
        }

        if (window.fbApi && window.fbApi.toggleLike) {
            window.fbApi.toggleLike(itemId, actionType).then((newCount) => {
                if (newCount !== null) {
                    const countSpan = clickedBtn.querySelector(`.fb-count`);
                    if (countSpan) {
                        countSpan.textContent = newCount;
                    }

                    localStorage.setItem(storageKey, actionType);
                    clickedBtn.classList.add(`fb-voted-active`);

                    const box = clickedBtn.closest(`.carousel-box`);
                    if (box) {
                        box.querySelectorAll(`.fb-rate-btn`).forEach((btn) => {
                            if (!btn.classList.contains(`fb-voted-active`)) {
                                btn.style.opacity = `0.4`;
                                btn.style.pointerEvents = `none`;
                                btn.style.cursor = `default`;
                            }
                        });
                    }
                }
            });
        }
    }

    window.handleFbRate = function (itemId, actionType) {
        const storageKey = `voted_${itemId}`;
        const alreadyVoted = localStorage.getItem(storageKey);

        if (alreadyVoted) {
            return;
        }

        const clickedBtn = event.currentTarget;
        if (!clickedBtn) return;

        if (window.fbApi && window.fbApi.toggleLike) {
            window.fbApi.toggleLike(itemId, actionType).then((newCount) => {
                if (newCount !== null) {
                    const countSpan = clickedBtn.querySelector(`.fb-count`);
                    if (countSpan) countSpan.textContent = newCount;

                    localStorage.setItem(storageKey, actionType);

                    clickedBtn.classList.add(`fb-voted-active`);

                    const box = clickedBtn.closest(`.carousel-box`);
                    if (box) {
                        box.querySelectorAll(`.fb-rate-btn`).forEach((btn) => {
                            if (!btn.classList.contains(`fb-voted-active`)) {
                                btn.style.opacity = `0.4`;
                                btn.style.pointerEvents = `none`;
                                btn.style.cursor = `default`;
                            }
                        });
                    }
                }
            });
        }
    };

