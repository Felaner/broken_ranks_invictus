    // Функция для инициализации навигации после вставки HTML
    function initGuideBookNavigation(containerId) {
        const guideBook = document.getElementById(containerId);
        if (!guideBook) return;

        const steps = guideBook.querySelectorAll(".guide-book-step");
        let current = 0;
        const prevBtn = guideBook.querySelector("#guide-prev");
        const nextBtn = guideBook.querySelector("#guide-next");

        function update() {
            steps.forEach((step, i) => {
                step.style.display = i === current ? "block" : "none";
            });
            prevBtn.disabled = current === 0;
            nextBtn.disabled = current === steps.length - 1;
        }

        prevBtn.onclick = () => {
            if (current > 0) {
                current--;
                update();
            }
        };

        nextBtn.onclick = () => {
            if (current < steps.length - 1) {
                current++;
                update();
            }
        };

        update();
    }

    function createEventPanel(eventsObj, options = {}) {
        const { topOffset = "50%", zIndex = 1000, iconSize = 36 } = options;

        const PANEL_ID = "event-panel-fixed";
        const MODAL_ID = "event-modal-info";

        const existingPanel = document.getElementById(PANEL_ID);
        if (existingPanel) existingPanel.remove();

        let modal = document.getElementById(MODAL_ID);
        if (!modal) {
            modal = document.createElement("div");
            modal.id = MODAL_ID;
            Object.assign(modal.style, {
                position: "fixed",
                width: "300px",
                padding: "10px",
                backgroundColor: "rgba(10, 10, 10, 0.85)",
                color: "white",
                border: "1px solid #686868",
                borderRadius: "8px",
                fontFamily: "Oswald",
                fontSize: "1rem",
                pointerEvents: "none",
                opacity: "0",
                transition: "opacity 0.2s",
                zIndex: zIndex + 1,
                userSelect: "none",
                top: "0",
                bottom: "0",
                height: "fit-content",
                margin: "auto 0 auto auto",
            });
            document.body.appendChild(modal);
        }

        function parseMoscowTimeToLocal(dateStr) {
            const [datePart, timePart] = dateStr.split("T");
            const [year, month, day] = datePart.split("-").map(Number);
            const [hour, minute, second] = timePart.split(":").map(Number);
            return new Date(
                Date.UTC(year, month - 1, day, hour - 3, minute, second),
            );
        }

        function createBWCanvas(img) {
            const bwCanvas = document.createElement("canvas");
            bwCanvas.width = iconSize;
            bwCanvas.height = iconSize;
            const bwCtx = bwCanvas.getContext("2d");

            bwCtx.drawImage(img, 0, 0, iconSize, iconSize);
            const imgData = bwCtx.getImageData(0, 0, iconSize, iconSize);
            const data = imgData.data;

            for (let i = 0; i < data.length; i += 4) {
                const r = data[i],
                    g = data[i + 1],
                    b = data[i + 2];
                const gray = 0.3 * r + 0.59 * g + 0.11 * b;
                data[i] = data[i + 1] = data[i + 2] = gray;
            }
            bwCtx.putImageData(imgData, 0, 0);

            return bwCanvas;
        }

        function createTimerIconCanvas(event) {
            const container = document.createElement("div");
            Object.assign(container.style, {
                width: iconSize + "px",
                height: iconSize + "px",
                borderRadius: "50%",
                boxSizing: "border-box",
                cursor: "pointer",
                overflow: "visible",
                filter: "none",
                position: "relative",
                userSelect: "none",
                display: "inline-block",
            });

            const canvas = document.createElement("canvas");
            canvas.width = iconSize;
            canvas.height = iconSize;
            canvas.style.borderRadius = "50%";
            container.appendChild(canvas);
            const ctx = canvas.getContext("2d");

            const img = new Image();
            img.crossOrigin = "anonymous";
            img.src = event.icon;

            img.onload = () => {
                const bwCanvas = createBWCanvas(img);

                const now = new Date();
                const start = parseMoscowTimeToLocal(event.start);
                const end = parseMoscowTimeToLocal(event.end);
                const fullCircle = 2 * Math.PI;
                const sectors = 96;

                ctx.clearRect(0, 0, iconSize, iconSize);

                if (now < start) {
                    const assumedDurationMs = 96 * 3600000;
                    let passedMs = assumedDurationMs - (start - now);
                    if (passedMs < 0) passedMs = 0;
                    const progress = Math.min(passedMs / assumedDurationMs, 1);

                    ctx.drawImage(bwCanvas, 0, 0, iconSize, iconSize);

                    const filledSectors = Math.round(progress * sectors);

                    for (let i = 0; i < filledSectors; i++) {
                        const startAngle =
                            (i / sectors) * fullCircle - Math.PI / 2;
                        const endAngle =
                            ((i + 1) / sectors) * fullCircle - Math.PI / 2;

                        ctx.save();
                        ctx.beginPath();
                        ctx.moveTo(iconSize / 2, iconSize / 2);
                        ctx.arc(
                            iconSize / 2,
                            iconSize / 2,
                            iconSize / 2,
                            startAngle,
                            endAngle,
                        );
                        ctx.closePath();
                        ctx.clip();

                        ctx.drawImage(img, 0, 0, iconSize, iconSize);
                        ctx.restore();
                    }

                    container.style.filter =
                        "drop-shadow(0 0 4px rgba(255,0,0,0.9))";
                } else if (now >= start && now <= end) {
                    const totalMs = end - start;
                    const passedMs = now - start;
                    const progress = Math.min(
                        Math.max(passedMs / totalMs, 0),
                        1,
                    );

                    ctx.drawImage(img, 0, 0, iconSize, iconSize);

                    const blackSectors = Math.round(progress * sectors);

                    for (let i = 0; i < blackSectors; i++) {
                        const startAngle =
                            (i / sectors) * fullCircle - Math.PI / 2;
                        const endAngle =
                            ((i + 1) / sectors) * fullCircle - Math.PI / 2;

                        ctx.save();
                        ctx.beginPath();
                        ctx.moveTo(iconSize / 2, iconSize / 2);
                        ctx.arc(
                            iconSize / 2,
                            iconSize / 2,
                            iconSize / 2,
                            startAngle,
                            endAngle,
                        );
                        ctx.closePath();
                        ctx.clip();

                        ctx.drawImage(bwCanvas, 0, 0, iconSize, iconSize);
                        ctx.restore();
                    }

                    container.style.filter =
                        "drop-shadow(0 0 4px rgba(0,255,0,0.9))";
                } else {
                    ctx.clearRect(0, 0, iconSize, iconSize);
                    container.style.filter = "none";
                }
            };

            return container;
        }

        const panel = document.createElement("div");
        panel.id = PANEL_ID;
        Object.assign(panel.style, {
            position: "fixed",
            right: "0",
            top: topOffset,
            transform: "translateY(-50%)",
            display: "flex",
            flexDirection: "column",
            gap: "10px",
            backgroundColor: "transparent",
            zIndex: zIndex,
            padding: "5px",
            userSelect: "none",
        });
        document.body.appendChild(panel);

        const now = new Date();

        let events = Object.values(eventsObj).filter(
            (ev) => parseMoscowTimeToLocal(ev.end) > now,
        );
        if (events.length === 0) return;

        events.sort(
            (a, b) =>
                parseMoscowTimeToLocal(a.start) -
                parseMoscowTimeToLocal(b.start),
        );
        let visibleEvents = events.slice(0, 2);

        let activeContainer = null;
        let leaveTimeout = null;

        function hideModal() {
            modal.style.opacity = "0";
            modal.style.pointerEvents = "none";
            if (activeContainer && activeContainer._timerInterval) {
                clearInterval(activeContainer._timerInterval);
                activeContainer._timerInterval = null;
            }
            activeContainer = null;
        }

        document.addEventListener("click", (e) => {
            if (
                !modal.contains(e.target) &&
                (!activeContainer || !activeContainer.contains(e.target))
            ) {
                hideModal();
            }
        });

        function handleMouseLeave(e) {
            const target = e.relatedTarget;

            if (
                target &&
                (modal.contains(target) ||
                    (activeContainer && activeContainer.contains(target)))
            ) {
                return;
            }

            if (leaveTimeout) clearTimeout(leaveTimeout);
            leaveTimeout = setTimeout(() => {
                hideModal();
            }, 150);
        }

        modal.addEventListener("mouseenter", () => {
            if (leaveTimeout) clearTimeout(leaveTimeout);
        });

        modal.addEventListener("mouseleave", handleMouseLeave);

        visibleEvents.forEach((event) => {
            const container = createTimerIconCanvas(event);

            container.addEventListener("mouseenter", () => {
                if (leaveTimeout) clearTimeout(leaveTimeout);

                if (activeContainer && activeContainer !== container) {
                    if (activeContainer._timerInterval) {
                        clearInterval(activeContainer._timerInterval);
                        activeContainer._timerInterval = null;
                    }
                }
                activeContainer = container;

                function formatTime(ms) {
                    const totalSec = Math.floor(ms / 1000);
                    const d = Math.floor(totalSec / 86400);
                    const h = Math.floor((totalSec % 86400) / 3600);
                    const m = Math.floor((totalSec % 3600) / 60);
                    const s = totalSec % 60;

                    return `
                    <span class="t">${d}</span><span class="l">д</span>
                    <span class="t">${h.toString().padStart(2, "0")}</span><span class="l">ч</span>
                    <span class="t">${m.toString().padStart(2, "0")}</span><span class="l">м</span>
                    <span class="t">${s.toString().padStart(2, "0")}</span><span class="l">с</span>
                    `;
                }

                function getTimerBlock() {
                    const now = new Date();
                    const start = parseMoscowTimeToLocal(event.start);
                    const end = parseMoscowTimeToLocal(event.end);

                    let label = "";
                    let diff = 0;
                    let color = "#c94b4b";

                    if (now < start) {
                        label = "До начала";
                        diff = start - now;
                        color = "#c94b4b";
                    } else if (now >= start && now <= end) {
                        label = "До окончания";
                        diff = end - now;
                        color = "#4bc96c";
                    } else {
                        return "";
                    }

                    return `
                    <div id="event-timer" style="
                        margin-top:10px;
                        padding:8px;
                        border:1px solid #444;
                        border-radius:6px;
                        background:linear-gradient(180deg, rgba(20,20,20,0.9), rgba(10,10,10,0.9));
                        box-shadow:0 0 10px rgba(0,0,0,0.8), inset 0 0 10px rgba(255,255,255,0.05);
                        font-family: 'Oswald';
                    ">
                        <div style="font-size:0.7rem; opacity:0.6; margin-bottom:4px;">${label}</div>
                        <div id="timer-values" style="
                            font-size:1.1rem;
                            letter-spacing:1px;
                            color:${color};
                            text-shadow:0 0 6px ${color};
                        ">
                            ${formatTime(diff)}
                        </div>
                    </div>
                    `;
                }

                modal.innerHTML = `
                    <span style="color:#e0d074;">${event.name}</span><br>
                    <div style="margin-top:5px; font-size:1rem;">${event.description}</div>
                    <div style="margin-top:5px; font-size:0.75rem; opacity:0.7;">
                        <div>Начало: ${parseMoscowTimeToLocal(event.start).toLocaleString()}</div>
                        <div>Окончание: ${parseMoscowTimeToLocal(event.end).toLocaleString()}</div>
                    </div>
                    ${getTimerBlock()}
                `;

                modal.style.opacity = "1";
                modal.style.pointerEvents = "auto";

                const rect = container.getBoundingClientRect();

                let left = rect.left - 300 - 10;
                if (left < 0) left = rect.right + 10;

                modal.style.left = left + "px";

                const timerEl = modal.querySelector("#timer-values");
                const timerBox = modal.querySelector("#event-timer");

                if (timerEl && timerBox) {
                    container._timerInterval = setInterval(() => {
                        const now = new Date();
                        const start = parseMoscowTimeToLocal(event.start);
                        const end = parseMoscowTimeToLocal(event.end);

                        let diff = 0;

                        if (now < start) diff = start - now;
                        else if (now <= end) diff = end - now;
                        else {
                            clearInterval(container._timerInterval);
                            timerBox.remove();
                            return;
                        }

                        timerEl.innerHTML = formatTime(diff);
                    }, 1000);
                }
            });

            container.addEventListener("mouseleave", handleMouseLeave);

            panel.appendChild(container);
        });
    }

