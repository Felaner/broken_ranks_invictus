            div = document.createElement("div"),
            span = document.createElement("span");
        table.append(tr);
        tr.prepend(td);
        td.classList.add("cell1");
        td.setAttribute("colspan", "2");
        td.prepend(div);
        div.classList.add("txtTitleEqRar");
        div.prepend(span);
        span.innerHTML = `${src}`;
