    function prepareMapElements(elements) {
        if (!elements || elements.length === 0) return [];

        return elements.map((item) => {
            // Ищем данные в основной базе: ключ 'id' должен совпадать с item.id
            const info = findAnteikuDB(anteikuDB, [["id", item.id]]);

            // Если findAnteikuDB вернул массив (несколько совпадений), берем первый
            const data = Array.isArray(info) ? info[0] : info;

            if (data) {
                return {
                    ...item,
                    img: data.img,
                    idCatalog: data.idCatalog,
                    title: data.title || data.name || "???",
                };
            }
            return item;
        });
    }

    function generateEntryTable(itemId) {
        const isWay = [`item1217`, `item1218`, `item1219`, `item1220`].includes(
            itemId,
        );
        const isBait = [`item172`, `item169`].includes(itemId);
        const isSpecialBait = itemId === `item169s`;

        if (!isWay && !isBait && !isSpecialBait) return ``;

        const titles = {
            item1217: `Путь непокоя`,
            item1218: `Путь страха`,
            item1219: `Путь тревоги`,
            item1220: `Путь ужаса`,
            item172: `Приманка для Ястреба`,
            item169: `Приманка для Вендиго`,
            item169s: `Приманка для Вендиго`,
        };

        let costs = [10, 6, 5, 4, 3];
        let maxPlayers = 5;

        if (isWay) {
            costs = [25, 13, 9, 7, 6];
        } else if (isSpecialBait) {
            costs = [4, 3];
            maxPlayers = 2;
        }

        const realItemId = itemId === `item169s` ? `item169` : itemId;
        const imgName = realItemId.replace(`item`, ``) + `.items2.png`;
        const itemIcon = `<img class="other-iconSh" data-items="${realItemId}" src="/raresImg/items2/${imgName}" title="${titles[itemId]}" style="vertical-align:middle; width:20px; height:20px; margin-left:4px;">`;

        const manSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e0e0e0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:1px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`;

        let rows = ``;
        for (let i = 0; i < maxPlayers; i++) {
            const peps = manSvg.repeat(i + 1);
            rows += `
            <tr style="border-bottom:1px solid #222;">
                <td style="padding:5px 10px; text-align:left; white-space:nowrap; line-height:1;">${peps}</td>
                <td style="padding:5px 10px; text-align:right; color:orange; font-weight:bold; white-space:nowrap;">${costs[i]}x${itemIcon}</td>
            </tr>
            `;
        }

        return `
            <table style="border-collapse:collapse; background-color:#0c0c0c; font-family:'Oswald', sans-serif; font-size:13px; border:1px solid #888; width:160px;">
            <thead>
                <tr style="background-color:#0a0a0a; color:#e0d074; border-bottom:1px solid #888;">
                <th colspan="2" style="padding:6px; text-align:center; font-size:14px; font-weight:normal;">${titles[itemId]}</th>
                </tr>
            </thead>
            <tbody>
                ${rows}
            </tbody>
            </table>
        `;
    }

