            } else if (activeTopId == `knight`) {
                p.id = "set50RcBlk";
            } else if (activeTopId == `voodoo`) {
                p.id = "set50VdBlk";
            } else if (activeTopId == `barbarian`) {
                p.id = "set50VrBlk";
            }

            if (activePanelTab === "equipment") {
                // !!! ДОБАВЛЯЙ КОНТЕНТ СЮДА (КЛАССОВАЯ ЭКИПИРОВКА) !!!
            } else {
                // !!! ДОБАВЛЯЙ КОНТЕНТ СЮДА (РАЗНОЕ) !!!
            }
            content.appendChild(p);
            p.innerHTML = ``;
            const sets = [
                {
                    id: "set50DruBlk",
                    classes: ["Set100dr", "Set50dr"],
                    title: "Фонарь Жизни",
                },
                {
                    id: "set50MonkBlk",
                    classes: ["Set100mnk", "Set50mnk"],
                    title: "Вашин",
                },
                {
                    id: "set50OmBlk",
                    classes: ["Set100om", "Set50om"],
                    title: "Гадюка",
                },
                {
                    id: "set50VdBlk",
                    classes: ["Set100vd", "Set50vd"],
                    title: "Аттава",
                },
                {
                    id: "set50RcBlk",
                    classes: ["Set100rc", "Set50rc"],
                    title: "Алленор",
                },
                {
                    id: "set50LkBlk",
                    classes: ["Set100lk", "Set50lk"],
                    title: "Имизиндо",
                },
                {
                    id: "set50VrBlk",
                    classes: ["Set100vr", "Set50vr"],
                    title: "Гортдар",
                },
            ];

            sets.forEach(({ id, classes, title }) => {
                try {
                    if (document.querySelector(`#${id}`)) {
                        classes.forEach((cls) =>
                            createRaresBlock(
                                findNestedObjects(massiveRars, [
                                    ["idClass", cls],
                                ]),
                                id,
                            ),
                        );
                        createRaresBlock(
                            findNestedObjects(massiveRars, [
                                ["title", "", title],
                            ]),
                            id,
                        );
                    }
                } catch (e) {}
            });
        }

        /* ================= MAIN RENDER ================= */
        function render() {
            renderTopTabs();
            setTopSelected();

            // Выбран класс
            if (classesMain[activeTopId] && activeTopId !== "common") {
                const c = classesMain[activeTopId];

                heroImg.src = c.image || "";
                heroImg.alt = c.name || "";
                titleEl.textContent = c.name || "";
                descEl.textContent = c.description || "";

                const ctx = { skills: skillsToArray(c.skills) };
                renderSubTabs(ctx);
                renderPanel(ctx);
                return;
            }

            // Выбраны общие common/special/passive
            const t =
                commonTabs.find((x) => x.id === activeTopId) || commonTabs[0];
            const block = t.getBlock() || {};

            heroImg.src = block.image || "";
            heroImg.alt = t.title;
            titleEl.textContent = t.title;
            descEl.textContent = block.description || "";

            const ctx = { skills: skillsToArray(block.skills) };
            renderSubTabs(ctx);
            renderPanel(ctx);
        }

        render();
    }

