    function showPreview(event, imageUrl) {
        previewImg.src = imageUrl;
        previewBox.style.display = "block";

        previewImg.onload = () => {
            const padding = 15;
            const imgWidth = previewImg.naturalWidth;
            const imgHeight = previewImg.naturalHeight;

            let left = event.pageX + padding;
            let top = event.pageY - imgHeight / 2;

            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;
            const scrollY = window.scrollY;

            // Если изображение выходит за правую границу — сместим влево
            if (left + imgWidth > viewportWidth) {
                left = event.pageX - imgWidth - padding;
            }

            // Если изображение выходит за верхнюю границу — прижмём к верху
            if (top < scrollY + padding) {
                top = scrollY + padding;
            }

            // Если изображение выходит за нижнюю границу — прижмём к низу
            if (top + imgHeight > scrollY + viewportHeight - padding) {
                top = scrollY + viewportHeight - imgHeight - padding;
            }

            previewBox.style.left = `${left}px`;
            previewBox.style.top = `${top}px`;

            requestAnimationFrame(() => {
                previewBox.classList.add("show");
            });
        };
    }

    function hidePreview() {
        previewBox.classList.remove("show");

        if (!previewBox.classList.contains("show")) {
            previewBox.style.display = "none";
        }
    }

