    function copyObjectsArray(objectsArray) {
        let copyArray = [];
        for (let i = 0; i < objectsArray.length; i++) {
            copyArray.push(Object.assign({}, objectsArray[i]));
        }
        return copyArray;
    }

    function getPropertyById(objArr, id, propertyName) {
        for (let i = 0; i < objArr.length; i++) {
            if (objArr[i].id === id) {
                return objArr[i][propertyName];
            }
        }
        return null;
    }

    function getPropertyByIdInArrays(arrayOfArrays, id, property) {
        for (let i = 0; i < arrayOfArrays.length; i++) {
            for (let j = 0; j < arrayOfArrays[i].length; j++) {
                if (arrayOfArrays[i][j].id === id) {
                    return arrayOfArrays[i][j][property];
                }
            }
        }
    }

    function sumTo(number) {
        let sum = 0;
        for (let i = 1; i <= number; i++) {
            sum += i;
        }
        return sum;
    }

    function sumByKey(array, key) {
        let sum = 0;
        for (let obj of array) {
            sum += obj[key];
        }
        return sum;
    }

    function copyObject(obj) {
        return Object.assign({}, obj);
    }

