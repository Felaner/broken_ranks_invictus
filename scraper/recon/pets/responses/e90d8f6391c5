    function findObjects(
        arr,
        propA,
        valueA,
        propB,
        valueB,
        propsToSum,
        classType,
        ile,
    ) {
        let treb1 = "";
        let treb2 = "";
        if (classType === "mag") {
            treb1 = "trebSila";
            treb2 = "trebLovkost";
        } else if (classType === "fiz") {
            treb1 = "trebZnanie";
            treb2 = "trebMosh";
        }
        let C = arr.reduce((acc, cur) => {
            return acc.concat(
                cur.filter((obj) => {
                    if (obj[propA] === valueA && !obj[treb1] && !obj[treb2]) {
                        return obj;
                    } else if (
                        typeof obj[propA] === "number" &&
                        obj[propA] <= valueA &&
                        !obj[treb1] &&
                        !obj[treb2]
                    ) {
                        return obj;
                    }
                }),
            );
        }, []);

        let EE = copyObjectsArray(C);
        let E = EE.filter((obj) => {
            return obj[propB] === valueB;
        });
        E.forEach((obj) => {
            propsToSum.forEach((prop) => {
                if (obj[prop]) {
                    if (
                        prop === "hp" ||
                        prop === "mana" ||
                        prop === "stamina"
                    ) {
                        obj[prop] /= 10;
                    } else if (
                        prop === "resRubyashii" ||
                        prop === "resDrobiashii" ||
                        prop === "resKolyushii"
                    ) {
                        obj[prop] *= 0.4;
                    } else if (
                        prop === "resOgon" ||
                        prop === "resHolod" ||
                        prop === "resEnergia"
                    ) {
                        obj[prop] *= 0.3;
                    } else if (prop === "resMental") {
                        obj[prop] *= 0.6;
                    } else if (prop === "damage") {
                        obj[prop] *= 2;
                    }
                }
            });
            obj.sum = propsToSum.reduce((acc, prop) => {
                if (obj[prop]) {
                    return acc + obj[prop];
                } else {
                    return acc;
                }
            }, 0);
        });
        E.sort((a, b) => {
            return a.sum - b.sum;
        });
        // return E;
        if (E.length > ile) {
            E.splice(0, E.length - ile);
            return E;
        } else {
            return E;
        }
    }

