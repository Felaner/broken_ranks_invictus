                const arenaSize = Math.min(arenaMaxWidth, rootWidth - 32);
                arenaWrap.style.width = arenaSize + "px";
                arenaWrap.style.height = arenaSize + "px";
                const positions = computePositions(arenaSize);

                arenaWrap
                    .querySelectorAll(".arena-pos")
                    .forEach((n) => n.remove());

                const assigned = new Array(12);
                for (let sector = 0; sector < 4; sector++) {
                    const posIdxs = sectorIndices[sector].slice();
                    const pool = ARENA_MOBS.map((m) => m.id);
                    let picks = [];
                    if (sector === comboIndex) {
                        picks.push(panelMob.id);
                        const poolRemaining = pool.filter(
                            (id) => id !== panelMob.id,
                        );
                        while (picks.length < 3) {
                            const r = poolRemaining.splice(
                                Math.floor(
                                    Math.random() * poolRemaining.length,
                                ),
                                1,
                            )[0];
                            if (r) picks.push(r);
                            if (poolRemaining.length === 0) break;
                        }
                    } else {
                        const poolCopy = pool.slice();
                        while (picks.length < 3 && poolCopy.length > 0) {
                            const idx = Math.floor(
                                Math.random() * poolCopy.length,
                            );
                            picks.push(poolCopy.splice(idx, 1)[0]);
                        }
                    }
                    for (let i = picks.length - 1; i > 0; i--) {
