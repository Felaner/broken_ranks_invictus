            mapDiv.appendChild(img);
            mapDiv.appendChild(layer);
            wrapper.appendChild(mapDiv);

            // Переменные для мобильного зума
            let initialDistance = 0;

            mapDiv.addEventListener(
                "touchstart",
                (e) => {
                    if (e.touches.length === 2) {
                        // Вычисляем начальное расстояние между двумя пальцами
                        initialDistance = Math.hypot(
                            e.touches[0].pageX - e.touches[1].pageX,
                            e.touches[0].pageY - e.touches[1].pageY,
                        );
                    } else if (e.touches.length === 1) {
                        // Логика начала перетаскивания одним пальцем
                        isDragging = true;
                        startX = e.touches[0].clientX - translateX;
                        startY = e.touches[0].clientY - translateY;
                    }
                },
                { passive: false },
            );

            mapDiv.addEventListener(
                "touchmove",
                (e) => {
                    if (scale <= MIN_SCALE && e.touches.length === 1) {
                        return; // Просто выходим из функции, не вызывая preventDefault
                    }
                    e.preventDefault(); // Запрещаем скролл всей страницы, пока мы на карте

                    if (e.touches.length === 2) {
                        // ЛОГИКА PINCH-TO-ZOOM
                        const currentDistance = Math.hypot(
                            e.touches[0].pageX - e.touches[1].pageX,
                            e.touches[0].pageY - e.touches[1].pageY,
                        );

                        const zoomFactor = currentDistance / initialDistance;
                        const oldScale = scale;
                        scale = Math.min(
                            MAX_SCALE,
                            Math.max(MIN_SCALE, scale * zoomFactor),
                        );

                        if (oldScale !== scale) {
                            // Центр между пальцами для зума
                            const centerX =
                                (e.touches[0].clientX + e.touches[1].clientX) /
                                2;
                            const centerY =
                                (e.touches[0].clientY + e.touches[1].clientY) /
                                2;
                            const rect = mapDiv.getBoundingClientRect();

                            translateX -=
                                (centerX - rect.left - translateX) *
                                (scale / oldScale - 1);
                            translateY -=
                                (centerY - rect.top - translateY) *
                                (scale / oldScale - 1);

                            initialDistance = currentDistance; // Обновляем дистанцию
                            updateTransform();
                        }
                    } else if (e.touches.length === 1 && isDragging) {
                        // ЛОГИКА ПЕРЕМЕЩЕНИЯ ОДНИМ ПАЛЬЦЕМ
                        translateX = e.touches[0].clientX - startX;
                        translateY = e.touches[0].clientY - startY;
                        updateTransform();
                    }
                },
                { passive: false },
            );

            mapDiv.addEventListener("touchend", () => {
                isDragging = false;
            });
            // --- ОБНОВЛЕННАЯ ЛОГИКА ZOOM И PAN ---
            let scale = 1;
            let isDragging = false;
            let startX, startY;
            let translateX = 0;
            let translateY = 0;
            let isMapActive = false;

            const MAX_SCALE = 2;
            const MIN_SCALE = 1;

            // Запрещаем дефолтное перетаскивание картинки браузером
            img.ondragstart = () => false;

            function updateTransform() {
                const rect = mapDiv.getBoundingClientRect();

                // 1. Ограничение границ (чтобы карта не улетала за края блока)
                const minX = rect.width - rect.width * scale;
                const minY = rect.height - rect.height * scale;

                translateX = Math.min(0, Math.max(translateX, minX));
                translateY = Math.min(0, Math.max(translateY, minY));

                // 2. Применяем трансформацию к фону и слою иконок
                const mapTransform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
                img.style.transform = mapTransform;
                layer.style.transform = mapTransform;

                const containerWidthFactor = Math.min(1, rect.width / 500);
                const s = (1 / scale) * containerWidthFactor;

                // 3. Сохраняем физический размер маркеров (Pins)
                const pins = layer.querySelectorAll(".mlb_pin");
                pins.forEach((pin) => {
                    // translate(-50%, -100%) — ножка в точке
                    // scale(${1 / scale}) — нейтрализация зума карты
                    pin.style.transform = `translate(-50%, -100%) scale(${s})`;
                });
                // Внутри updateTransform найди где обрабатываются pins и добавь:
                const portals = layer.querySelectorAll(`.other-iconPr`);
                portals.forEach((p) => {
                    p.style.transform = `translate(-50%, -50%) scale(${s})`;
                });

                // В функции обновления трансформации (при зуме)
                const labels = layer.querySelectorAll(".portal-label-sync");
                labels.forEach((l) => {
                    // Используем translate3d для аппаратного ускорения и четкости
                    l.style.transform = `translate3d(-50%, -20px, 0) scale(${s})`;
                });

                // 4. Сохраняем физический размер навигационных стрелок
                const arrows = layer.querySelectorAll(".mlb_arrow_nav");
                arrows.forEach((arrow) => {
                    // Для стрелок обычно центр в точке — translate(-50%, -50%)
                    arrow.style.transform = `translate(-50%, -50%) scale(${s})`;
                });
            }

            // 1. ZOOM
            mapDiv.addEventListener(
                "wheel",
                (e) => {
                    // Если карта не активна — ничего не делаем, даем странице скроллиться
                    if (!isMapActive) return;
                    e.preventDefault();
                    const delta = e.deltaY > 0 ? -0.1 : 0.1;
                    const oldScale = scale;
                    scale = Math.min(
                        MAX_SCALE,
                        Math.max(MIN_SCALE, scale + delta),
                    );

                    if (oldScale !== scale) {
                        const rect = mapDiv.getBoundingClientRect();
                        const mouseX = e.clientX - rect.left;
                        const mouseY = e.clientY - rect.top;

                        // Корректируем смещение, чтобы зум был в точку курсора
                        translateX -=
                            (mouseX - translateX) * (scale / oldScale - 1);
                        translateY -=
                            (mouseY - translateY) * (scale / oldScale - 1);

                        updateTransform();
                    }
                },
                { passive: false },
            );

            // 2. PAN (Перемещение)
            mapDiv.addEventListener("mousedown", (e) => {
                isMapActive = !isMapActive;
                mapDiv.classList.toggle("active", isMapActive);
                // Разрешаем тащить, только если есть зум
                if (scale <= 1) return;

                isDragging = true;
                startX = e.clientX - translateX;
                startY = e.clientY - translateY;

                img.style.transition = "none";
                layer.style.transition = "none";
                mapDiv.style.cursor = "grabbing";
            });

            // Деактивация, если кликнули мимо (на все окно)
            window.addEventListener("mousedown", (e) => {
                if (!mapDiv.contains(e.target)) {
                    isMapActive = false;
                    mapDiv.classList.remove("active");
                }
            });

            // Слушаем перемещение на window, чтобы не терять курсор при быстром движении
            window.addEventListener("mousemove", (e) => {
                if (!isDragging) return;
                e.preventDefault(); // Важно: предотвращает выделение текста и прочие баги
                translateX = e.clientX - startX;
                translateY = e.clientY - startY;
                updateTransform();
            });

            window.addEventListener("mouseup", () => {
                if (!isDragging) return;
                isDragging = false;
                img.style.transition = "transform 0.1s ease-out";
                layer.style.transition = "transform 0.1s ease-out";
                mapDiv.style.cursor = "grab";
            });

            if (
                !document.querySelector("#tableEq") &&
                !document.querySelector(".boss-arena-wrapper")
            ) {
                const controls = document.createElement("div");
                controls.className = "mlb_controls";

                // Создаем строку управления
                const row = document.createElement("div");
                row.className = "mlb_controls_row";

                // Группа кнопок (Слева)
                const btnGroup = document.createElement("div");
                btnGroup.className = "mlb_btn_group";
                btnGroup.innerHTML = `
                    <button class="mlb_btn" id="mlb_clear">Очистить</button>
                    <button class="mlb_btn" id="mlb_reset">Вернуть</button>
                `;

                // Инпут (Справа)
                const searchInp = document.createElement("input");
                searchInp.className = "mlb_search_input";
                searchInp.placeholder = "Поиск карт...";
                searchInp.autocomplete = "off";

                row.appendChild(btnGroup);
                row.appendChild(searchInp);

                // Сетка результатов
                const resGrid = document.createElement("div");
                resGrid.className = "mlb_search_results";
                resGrid.style.display = "none"; // Скрыта, пока нет поиска

                controls.appendChild(row);
                controls.appendChild(resGrid);

                // Логика поиска
                searchInp.oninput = () => {
                    const query = searchInp.value.toLowerCase().trim();
                    resGrid.innerHTML = "";

                    if (query.length < 2) {
                        resGrid.style.display = "none";
                        return;
                    }

                    let hasResults = false;
                    for (const [id, name] of Object.entries(MAP_NAMES)) {
                        if (name.toLowerCase().includes(query)) {
                            hasResults = true;
                            const idNum = id.replace(/\D/g, "");

                            const img = document.createElement("img");
                            img.className = "mlb_map_preview";
                            img.dataset.maps = id;
                            img.title = name;
                            img.src = `/raresImg/map/areasP/${idNum}_small.jpg`;

                            // Проверка второй папки при ошибке
                            img.onerror = () => {
                                if (!img.src.includes("areas2P")) {
                                    img.src = `/raresImg/map/areas2P/${idNum}_small.jpg`;
                                }
                            };

                            resGrid.appendChild(img);
                        }
                    }
                    resGrid.style.display = hasResults ? "grid" : "none";
                };

                // Функции кнопок
                controls.querySelector("#mlb_clear").onclick = () => {
                    layer.innerHTML = "";
                };
                controls.querySelector("#mlb_reset").onclick = () => {
                    layer.innerHTML = "";
                    renderItemsToLayer(layer, index);
                    updateTransform();
                };

                wrapper.appendChild(controls);
            }

            mainWrapper.appendChild(wrapper);
            renderItemsToLayer(layer, index);
        });

        container.appendChild(mainWrapper);
    }

    function addItemsToMap(containerId, data, categoryName = "Категория") {
        const container = document.getElementById(containerId);
        if (!container) return;

        // Находим все слои (их может быть несколько, если это путь)
        const layers = container.querySelectorAll(".mlb_layer");
