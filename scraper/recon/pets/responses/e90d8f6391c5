                        const mobId = picks[i] || ARENA_MOBS[0].id;
                        const mobData =
                            ARENA_MOBS.find((m) => m.id === mobId) ||
                            ARENA_MOBS[0];
                        assigned[pos] = mobData;
                    }
                }

                for (let i = 0; i < 12; i++) {
                    if (!assigned[i])
                        assigned[i] = ARENA_MOBS[i % ARENA_MOBS.length];
