    function findAnteikuDB(obj, searchCriteria) {
        const results = [];

        function search(currentObj, criteria) {
            for (const key in currentObj) {
                if (typeof currentObj[key] === "object") {
                    search(currentObj[key], criteria); // Recursively search nested objects
                } else if (
                    criteria.length === 1 &&
                    key === criteria[0][0] &&
                    (currentObj[key] === criteria[0][1] ||
                        currentObj[key].includes(`${criteria[0][2]}`))
                ) {
                    results.push(currentObj); // Found a match!
                }
            }
        }

        for (const criterion of searchCriteria) {
            search(obj, [criterion]); // Start the search for each criterion
        }

        return results.length > 1 ? results : results[0]; // Return array if multiple matches, otherwise single object
    }

