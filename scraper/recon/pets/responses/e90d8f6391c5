        // --- ГЛАВНОЕ ИСПРАВЛЕНИЕ ---
        const maps = container.querySelectorAll(".mlb_map");

        maps.forEach((mapDiv) => {
            const img = mapDiv.querySelector(".mlb_img");
            const layer = mapDiv.querySelector(".mlb_layer");

            if (!img || !layer) return;

            mapDiv.addEventListener("mouseenter", async () => {
                stopAndClear(layer);

                const scriptObj = findScript(img.src);
                if (!scriptObj) return;

                const objects = {};

                const currentGuide = { isActive: true };
                ActiveGuides[containerId] = currentGuide;

                const svg = document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "svg",
                );
                svg.setAttribute("class", "mguide_svg_canvas");
                svg.setAttribute(
                    "style",
                    "position:absolute; inset:0; width:100%; height:100%; pointer-events:none; z-index:5;",
                );
                svg.setAttribute("viewBox", "0 0 100 100");
                svg.setAttribute("preserveAspectRatio", "none");
                layer.appendChild(svg);

                const hero = document.createElement("img");
                hero.className = "mguide_hero";
                hero.src = "/raresImg/icons/shellbd.event.png";
                layer.appendChild(hero);

                for (const step of scriptObj.steps) {
                    if (!currentGuide.isActive) return;

                    switch (step.type) {
                        case "spawn_hero":
                            hero.style.left = step.x + "%";
                            hero.style.top = step.y + "%";
                            hero.style.display = "block";

                            // 🔥 ДОБАВКА
                            objects["hero"] = hero;

                            await wait(500);
                            break;

                        case "spawn_object": {
                            let obj;

                            if (step.icon && step.icon.trim().startsWith("<")) {
                                obj = document.createElement("div");
                                obj.innerHTML = step.icon;
                                obj = obj.firstElementChild;
                                obj.classList.add("mguide_object");
                                obj.style.pointerEvents = "auto";
                            } else {
                                obj = document.createElement("img");
                                obj.src =
                                    step.icon ||
                                    "/raresImg/icons/shellbd.event.png";
                            }

                            obj.className =
                                step.kind === "mob"
                                    ? "mguide_mob"
                                    : "mguide_hero";

                            obj.style.left = step.x + "%";
                            obj.style.top = step.y + "%";
                            obj.style.display = "block";

                            layer.appendChild(obj);

                            objects[step.id] = obj;

                            await wait(300);
                            break;
                        }

                        case "move_object": {
                            const obj = objects[step.id];
                            if (!obj) break;

                            const duration = step.duration || 1000;

                            // Устанавливаем скорость для конкретного объекта
                            obj.style.transitionDuration = duration + "ms";

                            obj.style.left = step.x + "%";
                            obj.style.top = step.y + "%";

                            if (!step.async) {
                                await wait(duration);
                            }
                            break;
                        }

                        case "draw_path_multi": {
                            const pts = step.points;
                            if (!pts || pts.length < 2) break;

                            const obj = objects[step.objectId];
                            const duration = step.duration || 2000; // Твоя длительность

                            // --- 1. СОБИРАЕМ ПУТЬ ---
                            let d = `M ${pts[0].x} ${pts[0].y}`;
                            for (let i = 1; i < pts.length; i++) {
                                d += ` L ${pts[i].x} ${pts[i].y}`;
                            }

                            const path = document.createElementNS(
                                "http://www.w3.org/2000/svg",
                                "path",
                            );
                            path.setAttribute("class", "mguide_path");
                            path.setAttribute("d", d);

                            // Добавляем transition для плавного исчезновения в будущем
                            path.style.transition = `stroke-dashoffset ${duration}ms linear, opacity 1s ease`;
                            path.style.opacity = "1";

                            svg.appendChild(path);
                            const totalLength = path.getTotalLength();

                            const dash = 2;
                            const gap = 6;
                            const dashUnit = dash + gap;
                            const adjustedLength =
                                Math.ceil(totalLength / dashUnit) * dashUnit;

                            path.style.strokeDasharray = `${dash} ${gap}`;
                            path.style.strokeDashoffset = adjustedLength;

                            // Синхронизируем анимацию линии с общей длительностью
                            path.style.transition = `stroke-dashoffset ${duration}ms linear`;
                            path.style.strokeDashoffset = "0";

                            await wait(20);
                            path.style.strokeDashoffset = "0";

                            // --- 2. РАВНОМЕРНОЕ ДВИЖЕНИЕ ОБЪЕКТА ---
                            if (obj) {
                                const start = performance.now();
                                const originalTransition = obj.style.transition;
                                obj.style.transition = "none"; // Отключаем CSS-переходы, чтобы не мешали JS-анимации

                                const animate = (now) => {
                                    const progress = Math.min(
                                        (now - start) / duration,
                                        1,
                                    );

                                    // Метод getPointAtLength(расстояние) дает идеальную равномерность
                                    const point = path.getPointAtLength(
                                        progress * totalLength,
                                    );

                                    obj.style.left = point.x + "%";
                                    obj.style.top = point.y + "%";

                                    if (progress < 1 && currentGuide.isActive) {
                                        requestAnimationFrame(animate);
                                    } else {
                                        obj.style.transition =
                                            originalTransition;
                                        // --- ЭФФЕКТ ИСЧЕЗНОВЕНИЯ ПУТИ ---
                                        path.style.opacity = "0"; // Делаем прозрачным
                                        path.remove();
                                    }
                                };

                                requestAnimationFrame(animate);

                                // Ждем ровно столько, сколько идет анимация (если не async)
                                if (!step.async) {
                                    await wait(duration);
                                }
                            }
                            break;
                        }

                        case "draw_path": {
                            const newPath = document.createElementNS(
                                "http://www.w3.org/2000/svg",
                                "path",
                            );
                            newPath.setAttribute("class", "mguide_path");

                            const d = `M ${step.from.x} ${step.from.y} L ${step.to.x} ${step.to.y}`;
                            newPath.setAttribute("d", d);

                            const dash = 2;
                            const gap = 6;
                            const dashUnit = dash + gap;

                            const length = Math.sqrt(
                                Math.pow(step.to.x - step.from.x, 2) +
                                    Math.pow(step.to.y - step.from.y, 2),
                            );

                            const adjustedLength =
                                Math.ceil(length / dashUnit) * dashUnit;

                            newPath.style.strokeDasharray = `${dash} ${gap}`;
                            newPath.style.strokeDashoffset = adjustedLength;

                            svg.appendChild(newPath);

                            await wait(50);
                            newPath.style.transition =
                                "stroke-dashoffset 1.5s linear";
                            newPath.style.strokeDashoffset = "0";

                            await wait(1500);
                            break;
                        }

                        case "move_hero": {
                            const duration = step.duration || 1000; // Если не указано, будет 1 сек

                            // Устанавливаем скорость анимации для CSS
                            hero.style.transitionDuration = duration + "ms";

                            // Задаем новые координаты
                            hero.style.left = step.x + "%";
                            hero.style.top = step.y + "%";

                            // Если не асинхронно — ждем завершения движения
                            if (!step.async) {
                                await wait(duration);
                            }
                            break;
                        }

                        case "spawn_mobs": {
                            const points = step.points || [];
                            const icons = step.icons || [];

                            for (let i = 0; i < points.length; i++) {
                                if (!currentGuide.isActive) return;

                                const coord = points[i];
                                const iconHTML = icons[i % icons.length]; // если иконок меньше

                                const mob = document.createElement("div");
                                mob.className = "mguide_mob";
                                mob.style.position = "absolute";
                                mob.style.left = coord.x + "%";
                                mob.style.top = coord.y + "%";
                                mob.style.transform =
                                    "translate(-50%, -50%) scale(0.8)";
                                mob.style.zIndex = 120;

                                // ВАЖНО: оставить кликабельность как у MapLibRender
                                mob.style.pointerEvents = "auto";

                                // сохраняем HTML как есть
                                mob.innerHTML = iconHTML;

                                layer.appendChild(mob);

                                // рандомная задержка между появлениями
                                const delay =
                                    (step.delayMin || 100) +
                                    Math.random() * (step.delayMax || 300);
                                await wait(delay);
                            }

                            break;
                        }

                        case "say": {
                            const bubble = document.createElement("div");
                            bubble.className = "mguide_text_bubble";
                            bubble.textContent = step.text;

                            const id = step.id || "hero";
                            const target = objects[id] || hero;
                            const theme = getSafePastelColor(id);
                            if (!target) break;

                            bubble.style.position = "absolute";
                            bubble.style.zIndex = 999999;
                            bubble.style.background = theme.bg;
                            bubble.style.color = theme.text;
                            bubble.style.border = theme.border;
                            bubble.style.boxShadow = theme.shadow;

                            document.body.appendChild(bubble);

                            let isTracking = true;
                            const updatePosition = () => {
                                if (!isTracking || !bubble.isConnected) return;
                                const rect = target.getBoundingClientRect();
                                bubble.style.left =
                                    rect.left + rect.width / 2 + "px";
                                bubble.style.top = rect.top - 14 + "px";
                                requestAnimationFrame(updatePosition);
                            };
                            updatePosition();

                            // --- ЛОГИКА ОДНОВРЕМЕННОСТИ ---
                            const duration = step.duration || 2000;

                            if (step.async) {
                                // Если шаг асинхронный, запускаем удаление через таймер и НЕ ждем (нет await)
                                setTimeout(() => {
                                    isTracking = false;
                                    bubble.remove();
                                }, duration);
                            } else {
                                // Обычное поведение: ждем завершения речи
                                await wait(duration);
                                isTracking = false;
                                bubble.remove();
                            }
                            break;
                        }

                        case "hide_hero":
                            hero.style.display = "none";
                            await wait(500);
                            break;

                        case "hide_object": {
                            // Ищем объект в твоем хранилище по ключу step.id
                            const target = objects[step.id];

                            if (target) {
                                target.style.display = "none";
                            } else {
                                // console.warn(`Объект с id "${step.id}" не найден в списке объектов.`);
                            }

                            await wait(500);
                            break;
                        }

                        case "show_marker": {
                            const marker = document.createElement("div");
                            marker.id = "guide_temp";
                            marker.className = "mlb_pin pulse";
                            marker.style.left = step.x + "%";
                            marker.style.top = step.y + "%";

                            marker.innerHTML = `
                            <div class="mlb_pin_head" style="background: ${step.color || "gold"};">
                                <div class="mlb_pin_icon" style="display:flex; align-items:center; justify-content:center; transform:rotate(45deg); font-size:16px;">
                                    ${step.icon || "⭐"}
                                </div>
                            </div>
                            <div class="mlb_pin_shadow"></div>
                        `;

                            layer.appendChild(marker);
                            await wait(800);
                            break;
                        }
                    }
                }
            });

            mapDiv.addEventListener("mouseleave", () => {
                if (ActiveGuides[containerId]) {
                    ActiveGuides[containerId].isActive = false;
                }

                if (layer.querySelectorAll(".mguide_mob")) {
                    const mobs = layer.querySelectorAll(".mguide_mob");
                    mobs.forEach((m) => m.remove());
                }
                if (document.querySelectorAll(".mguide_text_bubble")) {
                    document
                        .querySelectorAll(".mguide_text_bubble")
                        .forEach((m) => m.remove());
                }
                stopAndClear(layer);
            });
        });
    }

