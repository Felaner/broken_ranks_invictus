    async function MapAnimateGuide(containerId, scripts) {
        const container = document.getElementById(containerId);
        if (!container) return;

        const wait = (ms) => new Promise((res) => setTimeout(res, ms));

        function findScript(src) {
            return scripts.find((s) => src.includes(s.map));
        }

        function toScreen(layer, x, y) {
            const rect = layer.getBoundingClientRect();

            return {
                x: (x / 100) * rect.width,
                y: (y / 100) * rect.height,
            };
        }

        const _bubbleColors = {};

        function getSafePastelColor(id) {
            if (_bubbleColors[id]) return _bubbleColors[id];

            // Генерируем стабильный номер (hue) на основе строки ID
            let hash = 0;
            for (let i = 0; i < id.length; i++) {
                hash = id.charCodeAt(i) + ((hash << 5) - hash);
            }
            const h = Math.abs(hash % 360);

            // Проверяем, герой это или NPC (по вхождению 'juv' или 'hero')
            const isHero =
                id.toLowerCase().includes("juv") ||
                id.toLowerCase().includes("hero");

            if (isHero) {
                // СТИЛЬ ГЕРОЯ: Темный фэнтези (Черный + Золото)
                // Цвет рамки меняется в зависимости от ID для отличия героев
                _bubbleColors[id] = {
                    bg: "rgba(15, 15, 20, 0.98)",
                    text: "#FFD700", // Твое золото
                    border: `1px solid hsl(${h}, 80%, 50%)`, // Цветная рамка для отличия
                    shadow: `0 0 10px rgba(255, 215, 0, 0.2)`,
                };
            } else {
                // СТИЛЬ NPC: Пастельный (Светлый фон + темный текст)
                // Максимальная читаемость и отличие от героя
                _bubbleColors[id] = {
                    bg: `hsl(${h}, 70%, 88%)`,
                    text: "#000",
                    border: `1px solid hsl(${h}, 70%, 40%)`,
                    shadow: `0 4px 12px rgba(0,0,0,0.15)`,
                };
            }

            return _bubbleColors[id];
        }

        function stopAndClear(layer) {
            // Выбираем абсолютно все элементы, которые мы могли создать
            const toRemove = layer.querySelectorAll(
                '.mguide_hero, .mguide_mob, .mguide_svg_canvas, .mguide_text_bubble, .mlb_pin[id="guide_temp"]',
            );
            toRemove.forEach((el) => el.remove());
        }

        // --- Стили (как у тебя, без изменений) ---
        if (!document.getElementById("mguide_styles")) {
            const style = document.createElement("style");
            style.id = "mguide_styles";
            style.textContent = `
        .mguide_hero { 
            position: absolute; width: 32px; height: 32px; 
