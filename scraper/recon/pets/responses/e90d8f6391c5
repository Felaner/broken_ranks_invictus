            function computePositions(actualArenaSize) {
                const cx = actualArenaSize / 2;
                const cy = actualArenaSize / 2;
                let currentMobSize = 64;
                if (window.innerWidth <= 350) currentMobSize = 36;
                else if (window.innerWidth <= 410) currentMobSize = 40;
                else if (window.innerWidth <= 500) currentMobSize = 50;

                const radius = actualArenaSize / 2 - currentMobSize / 2 - 6;
                const positions = [];
                for (let i = 0; i < 12; i++) {
                    const angle = (i / 12) * 2 * Math.PI - Math.PI / 2;
                    const x = cx + radius * Math.cos(angle);
                    const y = cy + radius * Math.sin(angle);
                    positions.push({ x, y });
