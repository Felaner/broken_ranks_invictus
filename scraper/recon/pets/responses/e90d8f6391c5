            btn.onclick = () => {
                if (nextStageNumber === 2) startStage2();
                if (nextStageNumber === 3) startStage3();
            };
            cont.appendChild(btn);
            content.appendChild(cont);
        }

        startStage1();
    }

    function createSkillChart(containerId, data, options = {}) {
        let currentStage = 0;
        const COLORS = ["#E7C22B", "#E07000", "#FF0000"];

        const container = document.getElementById(containerId);
        if (!container || !Array.isArray(data)) return;

        const allowHtmlInDescriptions = !!options.allowHtmlInDescriptions;

        // ---------------------------
        // 1) ЯЗЫК
        // ---------------------------
        function getLang() {
            // 0=RU, 1=PL, 2=EN
            if (typeof options.lang === "number") return options.lang;
            if (typeof translatePL !== "undefined" && translatePL) return 1;
            if (typeof translateEN !== "undefined" && translateEN) return 2;
            return 0;
        }

        // ---------------------------
        // 2) ВСТРОЕННЫЕ СТРОКИ UI
        // ---------------------------
        const UI = {
            title: [
                "Развитие навыка",
                "Rozwój umiejętności",
                "Skill progression",
            ],
            stages: [
                ["Ученик", "Адепт", "Мастер"],
                ["Uczeń", "Adept", "Mistrz"],
                ["Apprentice", "Adept", "Master"],
            ],
            hintHover: ["(наведите на !)", "(najedź na !)", "(hover ! )"],
        };

        // ---------------------------
        // 3) МЕХАНИЗМ ЗАМЕН В ТЕКСТЕ
        // ---------------------------
        // Удобно расширять: добавляешь элемент в массив.
        //
        // Каждый элемент: { ru: /.../gi, pl: "...", en: "..." }
        // ru может быть RegExp или строкой.
        //
        const defaultReplacements = [
            // "шанс попадания" -> chance to hit / szansa trafienia
            {
                ru: /шанс\s+попадания/gi,
                pl: "szansa trafienia",
                en: "chance to hit",
            },
            { ru: /и/gi, pl: "i", en: "and" },
            { ru: /ОЗ/gi, pl: "PZ", en: "HP" },
            { ru: /покрова/gi, pl: "osłony", en: "of the barrier" },
            { ru: /уровень/gi, pl: "poz.postaci", en: "character lvl" },
            { ru: /формула/gi, pl: "wzór", en: "formula" },
            {
                ru: /когда\s+здоров/gi,
                pl: "gdy zdrowy",
                en: "when at full health",
            },
            {
                ru: /нанесенного\s+урона/gi,
                pl: "zadanych obrażeń",
                en: "of damage dealt",
            },
            {
                ru: /макс.\s+ресурсов/gi,
                pl: "max zasobów",
                en: "max resources",
            },
        ];

        // можно передать свои замены через options.replacements (добавятся к дефолтным)
        const replacements = [
            ...defaultReplacements,
            ...(Array.isArray(options.replacements)
                ? options.replacements
                : []),
        ];

        function normalizeSourcePattern(pat) {
            if (pat instanceof RegExp) return pat;
            // строку превращаем в regexp без спецсимволов
            const escaped = String(pat).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
            return new RegExp(escaped, "gi");
        }

        function translateInlineText(text, lang) {
            if (lang === 0) return text; // RU: ничего не меняем
            let out = String(text);

            for (const r of replacements) {
                const re = normalizeSourcePattern(r.ru);
                const to = lang === 1 ? (r.pl ?? "") : (r.en ?? "");
                if (!to) continue;
                out = out.replace(re, to);
            }
            return out;
        }

        // ---------------------------
        // 4) ОПРЕДЕЛЯЕМ КОЛ-ВО УРОВНЕЙ (7 / 14 / 21)
        // ---------------------------
        function detectLevelRowsCount(arr) {
            const lvlSet = new Set(["I", "II", "III", "IV", "V", "VI", "VII"]);
            let count = 0;
            while (count < arr.length) {
                const row = arr[count];
                if (!Array.isArray(row) || row.length < 2) break;
                if (!lvlSet.has(String(row[0]).trim())) break;
                count++;
            }
            return count; // 7 / 14 / 21
        }

        const levelRows = detectLevelRowsCount(data);
        const stageCount = Math.max(1, Math.min(3, Math.floor(levelRows / 7)));
        if (currentStage > stageCount - 1) currentStage = 0;

        const labelsBaseIndex = levelRows; // 7/14/21
        const descriptionsStartIndex = labelsBaseIndex + 3;

        // ---------------------------
        // 5) РЕНДЕР СКЕЛЕТА
        // ---------------------------
        const langInit = getLang();
        container.innerHTML = `
            <div class="usc-modal-header">${UI.title[langInit]}</div>
            <div class="usc-stage-buttons">
            <button data-stage="0" class="usc-active">${UI.stages[langInit][0]}</button>
            <button data-stage="1">${UI.stages[langInit][1]}</button>
            <button data-stage="2">${UI.stages[langInit][2]}</button>
            </div>
            <div id="${containerId}-usc-content"></div>
            <div id="${containerId}-usc-descriptions" class="usc-descriptions"></div>
            <div id="${containerId}-usc-tooltip" class="usc-tooltip"></div>
        `;

        const content = document.getElementById(`${containerId}-usc-content`);
        const descContainer = document.getElementById(
            `${containerId}-usc-descriptions`,
        );
        const tooltip = document.getElementById(`${containerId}-usc-tooltip`);

        function showTip(text) {
            tooltip.textContent = text;
            tooltip.style.opacity = 1;
        }
        function moveTip(e) {
            tooltip.style.left = e.clientX + 12 + "px";
            tooltip.style.top = e.clientY - 20 + "px";
        }
        function hideTip() {
            tooltip.style.opacity = 0;
        }

        // ---------------------------
        // 6) ПАРСИНГ ЯЧЕЙКИ: короткое + полное + число для столбца
        // ---------------------------
        function parseCell(raw, lang) {
            if (raw == null)
                return {
                    short: "",
                    full: "",
                    numeric: NaN,
                    unit: "",
                    needsHelp: false,
                };

            if (typeof raw === "number") {
                const full = String(raw);
                return {
                    short: full,
                    full,
                    numeric: raw,
                    unit: "",
                    needsHelp: false,
                };
            }

            const original = String(raw).trim();
            const full = translateInlineText(original, lang); // ✅ заменяем фразы в тексте

            // формула "уровень*X" — прячем за !
            const lvlRe =
                /^(?:уровень|level|lvl)\s*[x×*]\s*([+-]?\d+(?:[.,]\d+)?)$/i;
            const lvlM = original.match(lvlRe);
            if (lvlM) {
                const k = parseFloat(lvlM[1].replace(",", "."));
                return {
                    short: "…",
                    full,
                    numeric: Number.isFinite(k) ? k : NaN,
                    unit: "",
                    needsHelp: true,
                };
            }

            // число/процент в начале + хвост
            const m = original.match(/^([+-]?\d+(?:[.,]\d+)?)(\s*%)?\s*(.*)$/);
            if (m) {
                const num = parseFloat(m[1].replace(",", "."));
                const unit = m[2] ? "%" : "";
                const tail = (m[3] || "").trim();

                if (Number.isFinite(num)) {
                    const short = `${m[1].replace(",", ".")}${unit}`;
                    const needsHelp = tail.length > 0; // хвост в tooltip
                    return { short, full, numeric: num, unit, needsHelp };
                }
            }

            // любой другой текст — прячем за !
            return {
                short: "…",
                full,
                numeric: NaN,
                unit: "",
                needsHelp: true,
            };
        }

        // ---------------------------
        // 7) ОСНОВНОЙ РЕНДЕР
        // ---------------------------
        function render(stage) {
            const lang = getLang();

            // обновим UI заголовки если язык поменялся
            const header = container.querySelector(".usc-modal-header");
            if (header) header.textContent = UI.title[lang];

            const stageBtns = container.querySelectorAll(
                ".usc-stage-buttons button",
            );
            stageBtns.forEach((b, idx) => {
                b.textContent = UI.stages[lang][idx];
            });

            if (stage > stageCount - 1) stage = 0;
            currentStage = stage;

            const labels = data[labelsBaseIndex + lang];
            const start = stage * 7;
            const levels = data.slice(start, start + 7);
            const color = COLORS[stage];

            content.innerHTML = "";
            descContainer.innerHTML = "";

            for (let stat = 1; stat < labels.length; stat++) {
                const parsed = levels.map((l) => parseCell(l[stat], lang));
                const statHasHelp = parsed.some((p) => p.needsHelp);

                const nums = parsed
                    .map((p) => p.numeric)
                    .filter((n) => Number.isFinite(n));
                const canBar = nums.length > 0;
                const maxAbs = canBar
                    ? Math.max(...nums.map((n) => Math.abs(n)))
                    : 1;
                const safeMax = maxAbs && Number.isFinite(maxAbs) ? maxAbs : 1;

                const block = document.createElement("div");
                block.className = "usc-stat-block";

                const title = document.createElement("div");
                title.className = "usc-stat-title";
                title.textContent = labels[stat];

                if (statHasHelp) {
                    const hint = document.createElement("span");
                    hint.className = "usc-hint";
                    hint.textContent = UI.hintHover[lang];
                    title.appendChild(hint);
                }

                block.appendChild(title);

                const scale = document.createElement("div");
                scale.className = "usc-scale";

                levels.forEach((lvl, i) => {
                    const pv = parsed[i];

                    const col = document.createElement("div");
                    col.className = "usc-column";

                    const valueRow = document.createElement("div");
                    valueRow.className = "usc-valueRow";

                    const valueEl = document.createElement("div");
                    valueEl.className = "usc-value";
                    valueEl.textContent = pv.short;
                    valueEl.style.color = "#ffffffff";
                    valueRow.appendChild(valueEl);

                    let helpEl = null;
                    if (pv.needsHelp) {
                        helpEl = document.createElement("span");
                        helpEl.className = "usc-help";
                        helpEl.textContent = "!";
                        valueRow.appendChild(helpEl);
                    }

                    const bar = document.createElement("div");
                    bar.className = "usc-bar";
                    bar.style.background = color;

                    const height =
                        canBar && Number.isFinite(pv.numeric)
                            ? (Math.abs(pv.numeric) / safeMax) * 60 + 8
                            : 10;

                    bar.style.height = `${height}px`;
                    bar.style.opacity =
                        canBar && Number.isFinite(pv.numeric) ? 1 : 0.35;

                    const levelEl = document.createElement("div");
                    levelEl.className = "usc-level";
                    levelEl.textContent = lvl[0];
                    levelEl.style.color = color;

                    // hover на столбец:
                    // если есть ! -> показываем full
                    // иначе -> Δ
                    const onEnter = (e) => {
                        if (pv.needsHelp) {
                            showTip(pv.full);
                        } else if (i === 0) {
                            showTip("—");
                        } else {
                            const cur = parsed[i];
                            const prev = parsed[i - 1];
                            if (
                                Number.isFinite(cur.numeric) &&
                                Number.isFinite(prev.numeric)
                            ) {
                                const diff = cur.numeric - prev.numeric;
                                const unit = cur.unit || prev.unit ? "%" : "";
                                showTip(
                                    `${diff >= 0 ? "+" : ""}${diff}${unit}`,
                                );
                            } else {
                                showTip(cur.full);
                            }
                        }
                        moveTip(e);
                    };

                    bar.addEventListener("mouseenter", onEnter);
                    bar.addEventListener("mousemove", moveTip);
                    bar.addEventListener("mouseleave", hideTip);

                    // hover на !
                    if (helpEl) {
                        helpEl.addEventListener("mouseenter", (e) => {
                            showTip(pv.full);
                            moveTip(e);
                        });
                        helpEl.addEventListener("mousemove", moveTip);
                        helpEl.addEventListener("mouseleave", hideTip);
                    }

                    col.append(valueRow, bar, levelEl);
                    scale.appendChild(col);
                });

                block.appendChild(scale);
                content.appendChild(block);
            }

            // доп. описания
            for (let i = descriptionsStartIndex; i < data.length; i++) {
                const txt = data[i]?.[lang];
                if (txt == null) continue;

                const descDiv = document.createElement("div");
                const translated = translateInlineText(txt, lang);

                if (allowHtmlInDescriptions) descDiv.innerHTML = translated;
                else descDiv.innerHTML = translated;

                descContainer.appendChild(descDiv);
            }

            // кнопки стадий: скрываем лишние
            const buttons = container.querySelectorAll(
                ".usc-stage-buttons button",
            );
            buttons.forEach((b, idx) => {
                b.style.display = idx < stageCount ? "" : "none";

                b.classList.toggle("usc-active", idx === stage);
                b.style.background = idx === stage ? COLORS[stage] : "#1c1c1c";
                b.style.color = idx === stage ? "#000" : "#aaa";
            });
        }

        // кнопки стадий
        const buttons = container.querySelectorAll(".usc-stage-buttons button");
        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const stage = +btn.dataset.stage;
                if (stage < stageCount) render(stage);
            });
        });

        render(currentStage);
    }

