                    const pos = positions[i];
                    const wrap = el("div", { className: "arena-pos" });
                    wrap.style.left = pos.x + "px";
                    wrap.style.top = pos.y + "px";
                    let sectorOfIndex = 0;
                    for (const s in sectorIndices) {
                        if (sectorIndices[s].includes(i))
                            sectorOfIndex = Number(s);
                    }
                    const mobWrap = el("div", { className: "mob-wrap" });
                    mobWrap.style.border = `2px solid ${sectorColors[sectorOfIndex]}`;
                    const img = el("img", {
                        src: assigned[i].img,
                        title: assigned[i].name,
                    });
                    img.dataset.mobId = assigned[i].id;
                    img.dataset.index = String(i);
                    img.onclick = function () {
                        const clickedIndex = Number(this.dataset.index);
                        const clickedMobId = this.dataset.mobId;
                        const correctSector = comboIndex;
                        const isInCorrectSector =
                            sectorIndices[correctSector].includes(clickedIndex);
                        const isCorrectMob = clickedMobId === panelMob.id;
                        if (isInCorrectSector && isCorrectMob) {
                            successCount++;
                            if (successCount >= requiredCorrectStage2) {
                                arenaWrap.style.display = "none";
                                panel.style.display = "none";
                                resultBox.innerHTML = `<strong style="color:#619b3f;">Отлично! Этап 2 успешно завершён.</strong>`;
                                addContinueButton(3);
                                return;
                            } else {
                                resultBox.innerText = `Правильно! Прогресс: ${successCount} / ${requiredCorrectStage2}`;
                                setTimeout(() => startRound(), 300);
                                return;
                            }
                        } else {
                            arenaWrap.animate(
                                [
                                    { filter: "brightness(1)" },
                                    { filter: "brightness(0.2)" },
                                ],
                                { duration: 220, fill: "forwards" },
                            );
                            setTimeout(() => startStage2(), 480);
                            return;
                        }
                    };
                    mobWrap.appendChild(img);
                    wrap.appendChild(mobWrap);
                    arenaWrap.appendChild(wrap);
                }
            }

            successCount = 0;
            startRound();
        }

        function startStage3() {
