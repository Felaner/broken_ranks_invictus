        const controls = container.querySelectorAll(".mlb_controls");

        const controlPanel = container.querySelector(".mlb_controls");

        if (layers.length === 0 || controls.length === 0) {
            console.warn(
                "Карта не инициализирована или кнопки скрыты (модальное окно)",
            );
            return;
        }

        // Ищем именно группу кнопок внутри контролов
        let btnGroup = controlPanel.querySelector(".mlb_btn_group");

        const targetContainer = btnGroup || controlPanel;

        const list = Array.isArray(data) ? data : [data];

        // Создаём кнопку категории
        const btn = document.createElement("button");
        btn.className = "mlb_btn";
        btn.textContent = categoryName;

        // Вспомогательная функция для иконок (как в MapLibRender)
        function crtImgTagS(obj) {
            const el = document.createElement("img");
            el.dataset.items = obj.id;
            if (obj.idType === `enemiesMain`) {
                el.src = `/raresImg/${obj.idCatalog}/${obj.img}`;
            } else {
                el.src = `/raresImg/${obj.idCatalog}/${obj.img}.${obj.idCatalog}.png`;
            }
            el.title = obj.title;
            return el;
        }

        btn.onclick = () => {
            // 1. Очищаем ВСЕ слои на всех картах этапах
            layers.forEach((l) => (l.innerHTML = ""));

            // 2. Снимаем активность со всех кнопок во всех блоках управления
            container
                .querySelectorAll(".mlb_btn")
                .forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");

            // 3. Распределяем объекты по слоям
            layers.forEach((layer, mapIndex) => {
                list.forEach((obj) => {
                    const coord = Array.isArray(obj.coordId)
                        ? obj.coordId[mapIndex]
                        : obj.coordId;
                    if (!coord) return;

                    // Если это ТЕХНИЧЕСКАЯ стрелка (xS)
                    if (coord.xS !== undefined) {
                        const arrow = document.createElement("div");
                        arrow.className = "mlb_arrow_nav mlb_pulse";
                        arrow.style.left = coord.xS + "%";
                        arrow.style.top = coord.yS + "%";

                        const dx = coord.xS - 50;
                        const dy = coord.yS - 50;
                        const angle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;

                        arrow.innerHTML = `
                        <svg viewBox="0 0 24 24" style="transform: rotate(${angle}deg)">
                            <path d="M12 2L4.5 20.29L5.21 21L12 18L18.79 21L19.5 20.29L12 2Z" />
                        </svg>`;
                        layer.appendChild(arrow);
                    }
                    // Если это ПРЕДМЕТ (x)
