    function testTooltip(arr) {
        arr.forEach((elem) => {
            const elements = document.querySelectorAll(
                `[data-items="${elem.id}"]`,
            );

            elements.forEach((element) => {
                let tooltip = null;

                element.addEventListener("mouseenter", () => {
                    tooltip = document.createElement("div");
                    tooltip.classList.add("tooltipAn");

                    if (translatePL == true) {
                        tooltip.innerHTML = elem.descrPL;
                    } else if (translateEN == true) {
                        tooltip.innerHTML = elem.descrEN;
                    } else {
                        tooltip.innerHTML = elem.descr;
                    }

                    tooltip.style.backgroundColor = "#040404";
                    tooltip.style.color = "#e0d074";
                    tooltip.style.fontFamily = "Oswald, sans-serif";
                    tooltip.style.fontSize = "16px";
                    tooltip.style.padding = "6px 10px";
                    tooltip.style.borderRadius = "2px";
                    tooltip.style.border = "1px solid #888";
                    tooltip.style.boxShadow = "0 0 10px rgba(0, 0, 0, 0.8)";
                    tooltip.style.position = "fixed";
                    tooltip.style.zIndex = "99999";
                    tooltip.style.opacity = "0";
                    tooltip.style.pointerEvents = "none";
                    tooltip.style.maxWidth = "350px";
                    tooltip.style.wordWrap = "break-word";
                    tooltip.style.whiteSpace = "normal";

                    document.body.appendChild(tooltip);
                });

                element.addEventListener("mousemove", (event) => {
                    if (!tooltip) return;

                    const mouseX = event.clientX;
                    const mouseY = event.clientY;
                    const tooltipWidth = tooltip.offsetWidth;
                    const tooltipHeight = tooltip.offsetHeight;
                    const windowWidth = window.innerWidth;
                    const windowHeight = window.innerHeight;

                    let tooltipLeft = mouseX + 15;
                    let tooltipTop = mouseY - tooltipHeight - 10;

                    if (tooltipLeft + tooltipWidth > windowWidth) {
                        tooltipLeft = mouseX - tooltipWidth - 15;
                        if (tooltipLeft < 0) {
                            tooltipLeft = windowWidth - tooltipWidth - 10;
                        }
                    }

                    if (tooltipTop < 0) {
                        tooltipTop = mouseY + 20;
                        if (tooltipTop + tooltipHeight > windowHeight) {
                            tooltipTop = windowHeight - tooltipHeight - 10;
                        }
                    }

                    tooltip.style.left = `${tooltipLeft}px`;
                    tooltip.style.top = `${tooltipTop}px`;
                    tooltip.style.opacity = "1";
                });

                element.addEventListener("mouseleave", () => {
                    if (tooltip) {
                        tooltip.remove();
                        tooltip = null;
                    }
                });
            });
        });
    }

