                b.title = t.title;
                b.innerHTML = `<img src="${t.icon}" alt="${t.title}">`;
                b.onclick = () => {
                    activeTopId = t.id;
                    activePanelTab = "skills";
                    render();
                };
                top.appendChild(b);
            });

            setTopSelected();
        }

        /* ================= RIGHT TABS ================= */
        function renderSubTabs(ctx) {
            subTabs.innerHTML = "";
            panelTabs.forEach((t) => {
                const b = document.createElement("button");
                b.className = "tp-subTab";
                b.textContent = t.label;
                b.dataset.id = t.id;
                b.setAttribute(
                    "aria-selected",
                    t.id === activePanelTab ? "true" : "false",
                );
                b.onclick = () => {
                    activePanelTab = t.id;
                    renderPanel(ctx);
                };
                subTabs.appendChild(b);
            });
        }

        function renderPanel(ctx) {
            // update selected state
            subTabs.querySelectorAll(".tp-subTab").forEach((b) => {
                b.setAttribute(
                    "aria-selected",
                    b.dataset.id === activePanelTab ? "true" : "false",
                );
            });

            content.innerHTML = "";

            if (activePanelTab === "skills") {
                const grid = document.createElement("div");
                grid.className = "tp-skillTiles";

                ctx.skills.forEach((sk) => {
                    const tile = document.createElement("div");
                    tile.className = "tp-skillTile";
                    tile.innerHTML = `
                        <div class="tp-skillIconWrap">${sk.icon}</div>
                        <div class="tp-skillLabel">
                            <div class="tp-skillName">${sk.name}</div>
                        </div>
                    `;
                    grid.appendChild(tile);
                });

                content.appendChild(grid);
                return;
            }

            const p = document.createElement("div");
            // p.className = "tp-placeholder";set50DruBlk

            if (activeTopId == `druid`) {
                p.id = "set50DruBlk";
