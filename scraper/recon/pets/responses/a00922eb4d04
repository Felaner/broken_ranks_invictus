class Lightbox {
    constructor() {
        this.injectStyles();
        this.createLightbox();
        this.observeImages();
    }

    injectStyles() {
        const css = `
            .lightbox {
                position: fixed;
                top: 0; left: 0;
                width: 100%; height: 100%;
                background: rgba(0, 0, 0, 0.8);
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.3s;
                overflow: hidden;
                z-index: 1000;
            }
            .lightbox.active {
                opacity: 1;
                pointer-events: all;
            }
            .lightbox img {
                max-width: 90%;
                max-height: 90%;
                transform-origin: center;
                cursor: grab;
                position: relative;
                user-select: none;
            }
            .close {
                position: absolute;
                top: 15px; right: 15px;
                font-size: 30px;
                color: white;
                cursor: pointer;
                background: rgba(0, 0, 0, 0.6);
                padding: 5px 10px;
                border-radius: 5px;
                z-index: 1100;
            }
            .zoom {
                position: absolute;
                bottom: 20px;
                display: flex;
                gap: 15px;
            }
            .zoom button {
                padding: 10px;
                font-size: 16px;
                cursor: pointer;
                background: rgba(255, 255, 255, 0.8);
                border: none;
                border-radius: 5px;
            }
        `;
        const style = document.createElement("style");
        style.innerHTML = css;
        document.head.appendChild(style);
    }

    createLightbox() {
        this.lightbox = document.createElement("div");
        this.lightbox.className = "lightbox";
        this.lightbox.innerHTML = `
            <span class="close">✖</span>
            <img id="lightbox-img">
            <div class="zoom">
                <button class="zoom-in">➕</button>
                <button class="zoom-out">➖</button>
            </div>
        `;
        document.body.appendChild(this.lightbox);

        this.lightboxImg = this.lightbox.querySelector("#lightbox-img");
        this.closeBtn = this.lightbox.querySelector(".close");
        this.zoomInBtn = this.lightbox.querySelector(".zoom-in");
        this.zoomOutBtn = this.lightbox.querySelector(".zoom-out");

        this.scale = 1;
        this.isDragging = false;
        this.startX = 0;
        this.startY = 0;
        this.imgX = 0;
        this.imgY = 0;
        this.maxTranslateX = 0;
        this.maxTranslateY = 0;

        this.attachEvents();
    }

    attachEvents() {
        this.closeBtn.addEventListener("click", () => this.close());
        this.zoomInBtn.addEventListener("click", () => this.zoom(0.2));
        this.zoomOutBtn.addEventListener("click", () => this.zoom(-0.2));

        this.lightbox.addEventListener("wheel", (e) => this.onWheel(e));
        this.lightboxImg.addEventListener("mousedown", (e) => this.onDragStart(e));
        window.addEventListener("mousemove", (e) => this.onDragMove(e));
        window.addEventListener("mouseup", () => this.onDragEnd());
        this.lightboxImg.addEventListener("dragstart", (e) => e.preventDefault());

        this.lightbox.addEventListener("click", (e) => {
            if (e.target === this.lightbox) this.close();
        });
    }

    observeImages() {
        const observer = new MutationObserver(() => this.addClickEvents());
        observer.observe(document.body, { childList: true, subtree: true });
        this.addClickEvents();
    }

    addClickEvents() {
        document.querySelectorAll("img[data-full]").forEach(img => {
            if (!img.dataset.lightboxAttached) {
                img.dataset.lightboxAttached = "true";
                img.addEventListener("click", () => this.open(img));
            }
        });
    }

    open(img) {
        this.lightboxImg.src = img.dataset.full;
        this.lightbox.classList.add("active");
        this.scale = 1;
        this.imgX = 0;
        this.imgY = 0;
        this.updateLimits();
        this.updateTransform();
    }

    close() {
        this.lightbox.classList.remove("active");
    }

    updateLimits() {
        const imgWidth = this.lightboxImg.naturalWidth * this.scale;
        const imgHeight = this.lightboxImg.naturalHeight * this.scale;
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;

        this.maxTranslateX = Math.max(0, (imgWidth - viewportWidth) / 2);
        this.maxTranslateY = Math.max(0, (imgHeight - viewportHeight) / 2);

        this.imgX = Math.min(Math.max(this.imgX, -this.maxTranslateX), this.maxTranslateX);
        this.imgY = Math.min(Math.max(this.imgY, -this.maxTranslateY), this.maxTranslateY);
    }

    updateTransform() {
        this.lightboxImg.style.transform = `translate(${this.imgX}px, ${this.imgY}px) scale(${this.scale})`;
    }

    zoom(delta) {
        this.scale = Math.max(1, Math.min(this.scale + delta, 3));
        this.updateLimits();
        this.updateTransform();
    }

    onWheel(event) {
        event.preventDefault();
        this.zoom(event.deltaY < 0 ? 0.1 : -0.1);
    }

    onDragStart(event) {
        if (this.maxTranslateX > 0 || this.maxTranslateY > 0) {
            this.isDragging = true;
            this.startX = event.clientX - this.imgX;
            this.startY = event.clientY - this.imgY;
            this.lightboxImg.style.cursor = "grabbing";
            event.preventDefault();
        }
    }

    onDragMove(event) {
        if (!this.isDragging) return;

        let newX = event.clientX - this.startX;
        let newY = event.clientY - this.startY;

        this.imgX = Math.min(Math.max(newX, -this.maxTranslateX), this.maxTranslateX);
        this.imgY = Math.min(Math.max(newY, -this.maxTranslateY), this.maxTranslateY);

        this.updateTransform();
    }

    onDragEnd() {
        this.isDragging = false;
        this.lightboxImg.style.cursor = "grab";
    }
}

// Автоматически запускаем библиотеку
document.addEventListener("DOMContentLoaded", () => new Lightbox());
