    function startWaveEffect() {
        const spans = document.querySelectorAll('#customHeaderText span');
  
        // Функция для сброса анимации и запуска заново
        const resetAnimation = () => {
            spans.forEach((span) => {
                span.style.animation = 'none';  // Сбрасываем анимацию
                span.offsetHeight; // Это заставляет браузер пересчитать элемент (необходимый трюк для сброса анимации)
                span.style.animation = ''; // Восстанавливаем анимацию
            });
